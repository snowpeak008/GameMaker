{
  "identity": {
    "schema_version": "4.0.0",
    "project_id": "网格迁移基准@sha256:d976d5d4cea62a08",
    "frozen_hash": "sha256:d976d5d4cea62a08dac91ef4671f10e7de5b58522214e1bf5dd000b9a12ea340"
  },
  "intent": {
    "title": "网格迁移基准",
    "experience_promise": "以小博大的守护：",
    "genre_structure": "网格战棋",
    "profile": {
      "u.business_model": "买断制",
      "u.platform": "PC 单机"
    }
  },
  "systems": [
    {
      "id": "grid.battlefield_system",
      "name": "方形网格",
      "purpose": "战场由方形格组成，四方向邻接，移动与射程按格计算",
      "interfaces": [
        "需要逐格移动规则",
        "需要地形效果规则",
        "射程与距离按曼哈顿距离计算"
      ],
      "design_notes": []
    },
    {
      "id": "grid.combat_system",
      "name": "确定性结算",
      "purpose": "攻击必然命中，伤害由公式与克制唯一确定，无命中随机",
      "interfaces": [
        "信息完全公开，策略深度来自站位与克制",
        "需要伤害公式与兵种克制矩阵",
        "敌方意图需要提前展示以支撑推演"
      ],
      "design_notes": []
    },
    {
      "id": "grid.progression_system",
      "name": "经验升级成长",
      "purpose": "单位通过战斗行为获取经验，升级提升属性",
      "interfaces": [
        "需要经验获取规则",
        "需要养成数值表",
        "战斗内成长使练兵本身成为玩法"
      ],
      "design_notes": []
    },
    {
      "id": "grid.stage_system",
      "name": "线性战役",
      "purpose": "关卡按固定顺序推进，难度曲线全局可控",
      "interfaces": [
        "需要胜负判定规则",
        "需要关卡表与敌方配置表",
        "单一路线便于精确调节难度曲线"
      ],
      "design_notes": []
    },
    {
      "id": "grid.turn_system",
      "name": "敌我阶段交替",
      "purpose": "我方全体单位行动完毕后轮到敌方，整队轮换",
      "interfaces": [
        "需要行动点规则",
        "单回合内可自由安排己方行动顺序",
        "敌方回合是纯观战节点，需要演出与信息设计"
      ],
      "design_notes": []
    },
    {
      "id": "grid.unit_system",
      "name": "兵种职业体系",
      "purpose": "单位由兵种模板派生，同兵种共享属性框架与克制标签",
      "interfaces": [
        "需要单位属性表与兵种表",
        "兵种克制是平衡性的主要抓手"
      ],
      "design_notes": []
    }
  ],
  "mechanics": [
    {
      "id": "grid.action_point_rule",
      "system_id": "grid.turn_system",
      "rule_text": "移动加行动两段制。每单位每回合一次移动与一次行动，执行行动后该单位本回合结束（allow_move_after_act=false）",
      "preconditions": [],
      "effects": [
        {
          "effect": "consume_resource",
          "resource": "action_slot",
          "formula": "1 per act"
        },
        {
          "effect": "change_state",
          "machine": "unit_turn_state",
          "to_state": "acted"
        }
      ],
      "state_machine": null,
      "design_notes": []
    },
    {
      "id": "grid.counter_attack_rule",
      "system_id": "grid.combat_system",
      "rule_text": "射程内自动反击。受击方存活且武器射程覆盖攻击方时，立即反击一次（counter_damage_ratio=1）",
      "preconditions": [],
      "effects": [
        {
          "effect": "modify_property",
          "entity": "grid.unit_roster",
          "property": "hp",
          "formula": "attacker.hp - counter_damage * 1"
        }
      ],
      "state_machine": null,
      "design_notes": []
    },
    {
      "id": "grid.damage_formula",
      "system_id": "grid.combat_system",
      "rule_text": "攻减防线性公式。伤害 = (攻击 − 防御) × 克制系数 − 地形减伤，带最低伤害保底（min_damage=1）",
      "preconditions": [],
      "effects": [
        {
          "effect": "modify_property",
          "entity": "grid.unit_roster",
          "property": "hp",
          "formula": "hp - max((atk - def) * counter_coeff - terrain_def_bonus, 1)"
        }
      ],
      "state_machine": null,
      "design_notes": []
    },
    {
      "id": "grid.exp_gain_rule",
      "system_id": "grid.progression_system",
      "rule_text": "行动经验制。攻击、击杀、辅助分别给固定经验，攒满定额升一级（exp_per_level=100, kill_bonus_multiplier=3）",
      "preconditions": [],
      "effects": [
        {
          "effect": "grant_resource",
          "resource": "exp",
          "formula": "base_action_exp * 3 on kill"
        }
      ],
      "state_machine": null,
      "design_notes": []
    },
    {
      "id": "grid.move_rule",
      "system_id": "grid.battlefield_system",
      "rule_text": "地形移动力消耗。每进入一格消耗该地形的移动成本，路径总消耗不得超过单位移动力（zoc_enabled=true）",
      "preconditions": [],
      "effects": [
        {
          "effect": "modify_property",
          "entity": "grid.unit_roster",
          "property": "position",
          "formula": "path_min_cost(terrain_move_cost) <= move"
        }
      ],
      "state_machine": null,
      "design_notes": []
    },
    {
      "id": "grid.terrain_effect_rule",
      "system_id": "grid.battlefield_system",
      "rule_text": "地形修正数值叠加。站位地形按地形表提供回避与减伤加值，叠加进战斗公式（flier_ignore_terrain=true）",
      "preconditions": [],
      "effects": [
        {
          "effect": "modify_property",
          "entity": "grid.unit_roster",
          "property": "evade",
          "formula": "evade + terrain_evade_bonus"
        },
        {
          "effect": "modify_property",
          "entity": "grid.unit_roster",
          "property": "def",
          "formula": "def + terrain_def_bonus"
        }
      ],
      "state_machine": null,
      "design_notes": []
    },
    {
      "id": "grid.victory_condition_rule",
      "system_id": "grid.stage_system",
      "rule_text": "目标制胜负。每关声明胜利与失败目标（歼灭、占点、坚守、护送），达成即结算（default_turn_limit=20）",
      "preconditions": [],
      "effects": [
        {
          "effect": "emit_signal",
          "signal": "stage_victory"
        },
        {
          "effect": "emit_signal",
          "signal": "stage_defeat"
        }
      ],
      "state_machine": null,
      "design_notes": []
    }
  ],
