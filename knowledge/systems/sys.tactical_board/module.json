{
  "module_id": "sys.tactical_board",
  "semver": "1.1.0",
  "label_zh": "战术棋盘",
  "summary": "离散网格上的单位占位、移动力与地形效果系统（附录 G5）。全谱系 TB0-TB3：静态站位（JRPG 前后排）→ 网格移动+射程/移动力 → 地形效果+高低差+朝向背刺 → 可破坏可改造棋盘+推拉位移连锁。与 #38 三消棋盘边界：同为网格但规则闭包不同（占位战斗 vs 交换消除），不合并。1.1.0（T-W7-4b）：前置 MG0/MG1 两个存量迁移承接档，原样承接 grid_strategy 的网格/地形四点（battlefield_system/move_rule/terrain_effect_rule/terrain_table，实例 id=grid 保 id）；量产波金样重固化窗口时并入 TB 谱系正式档。",
  "nouns": [
    {
      "id": "board_occupancy",
      "kind": { "kind": "property", "of": "tactical_board" },
      "label_zh": "棋盘格占用表",
      "summary": "本系统独占的核心状态：哪个格被哪个单位占据。占位互斥、移动合法性、包夹判定都以它为唯一真相。"
    },
    {
      "id": "unit_position_state",
      "kind": { "kind": "property", "of": "board_unit" },
      "label_zh": "单位位置状态",
      "summary": "单位在棋盘上的坐标/排位/朝向/高度层——对外供给的位置真相，供战斗公式（射程/背刺/高低差修正）消费。"
    },
    {
      "id": "terrain_tile",
      "kind": { "kind": "entity_class" },
      "label_zh": "地形格实体",
      "summary": "带行标识与属性列的地形格：类型、通行成本、掩体值、高度、可破坏耐久都是它的列。"
    },
    {
      "id": "terrain_modifier_slot",
      "kind": { "kind": "rule_slot" },
      "label_zh": "地形修饰器挂点",
      "summary": "地形效果规则的可修改挂点：地形对站位单位输出的修饰器（掩体减伤/沼泽减速）经此挂出，也允许他系统 ModifyRule（如技能点燃草地改写格效果）。"
    },
    {
      "id": "move_resolved_signal",
      "kind": { "kind": "signal" },
      "label_zh": "移动结算事件",
      "summary": "一次移动/位移最终落位的时点信号，载荷为单位、起点与终点；供借机攻击、陷阱触发、连锁位移监听。"
    }
  ],
  "interface": {
    "provides": ["unit_position_state", "terrain_modifier_slot", "move_resolved_signal"],
    "consumes": [
      "sys.turn_combat.unit_entity",
      "sys.turn_combat.move_command"
    ],
    "modifies": ["board_occupancy"]
  },
  "mda": {
    "mechanics_summary": "站位排布/排位效果/网格拓扑/移动力预算/射程与视线/地形效果表/高低差修正/朝向背刺/棋盘改造/推拉位移连锁的机制群。",
    "dynamics_notes": [
      "玩家在移动确认前反复预览可达域与威胁域（信号：移动预览悬停时长、悔棋/撤销使用率）",
      "TB2 档地形与朝向让同一场战斗出现走位流派分化（信号：同关卡通关站位热力图的多峰分布）",
      "TB3 档推拉连锁催生『一步多杀』的组合技追求（信号：位移致死占总击杀比、连锁长度分布）"
    ],
    "aesthetics_primary": ["挑战"]
  },
