  "decision_points": [
    {
      "id": "sys.tactical_board.battlefield_system",
      "node_id": "grid_battlefield",
      "domain": "battlefield",
      "level": "L3",
      "genre_scope": "universal",
      "question": "战场采用什么网格结构？",
      "tier_gate": "mg0_migration_base",
      "options": [
        {
          "id": "square_grid",
          "label": "方形网格",
          "summary": "战场由方形格组成，四方向邻接，移动与射程按格计算",
          "implications": ["需要逐格移动规则", "需要地形效果规则", "射程与距离按曼哈顿距离计算"],
          "unlocks": ["sys.tactical_board.move_rule", "sys.tactical_board.terrain_effect_rule"]
        },
        {
          "id": "hex_grid",
          "label": "六边形网格",
          "summary": "战场由六边形格组成，六方向邻接，包抄与侧翼路线更多",
          "implications": ["需要逐格移动规则", "需要地形效果规则", "寻路与射程按六向邻接计算"],
          "unlocks": ["sys.tactical_board.move_rule", "sys.tactical_board.terrain_effect_rule"]
        }
      ]
    },
    {
      "id": "sys.tactical_board.move_rule",
      "node_id": "grid_battlefield",
      "domain": "battlefield",
      "level": "L4",
      "genre_scope": "universal",
      "question": "网格移动的机制规则是什么？",
      "tier_gate": "mg0_migration_base",
      "options": [
        {
          "id": "move_point_cost",
          "label": "地形移动力消耗",
          "summary": "每进入一格消耗该地形的移动成本，路径总消耗不得超过单位移动力",
          "implications": ["地形表成为走位策略核心", "寻路采用最小消耗路径", "机动类别可对特定地形改写消耗"],
          "unlocks": ["sys.tactical_board.terrain_table"],
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "zoc_enabled", "kind": { "kind": "bool" }, "required": true }
          ] },
          "compiler_tags": { "spec_role": "mechanic", "system": "grid.battlefield_system" },
          "effects_template": [
            { "effect": "modify_property", "entity": "grid.unit_roster", "property": "position", "formula": "path_min_cost(terrain_move_cost) <= move" }
          ]
        },
        {
          "id": "fixed_range_move",
          "label": "固定范围移动",
          "summary": "移动范围为以自身为中心的固定格数，无视地形差异",
          "implications": ["地形只影响战斗不影响机动", "数值调优集中在移动力字段", "规则可读性高，适合快节奏关卡"],
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "pass_through_allies", "kind": { "kind": "bool" }, "required": true }
          ] },
          "compiler_tags": { "spec_role": "mechanic", "system": "grid.battlefield_system" },
          "effects_template": [
            { "effect": "modify_property", "entity": "grid.unit_roster", "property": "position", "formula": "grid_distance(origin, target) <= move" }
          ]
        }
      ]
    },
    {
      "id": "sys.tactical_board.terrain_effect_rule",
      "node_id": "grid_terrain",
      "domain": "terrain",
      "level": "L4",
      "genre_scope": "universal",
      "question": "地形加成的机制规则是什么？",
      "tier_gate": "mg1_terrain_carrier",
      "options": [
        {
          "id": "terrain_modifier_stack",
          "label": "地形修正数值叠加",
          "summary": "站位地形按地形表提供回避与减伤加值，叠加进战斗公式",
          "implications": ["地形表数值直接进战斗公式", "抢占强势地形成为核心走位动机", "飞行类机动可豁免地形修正"],
          "unlocks": ["sys.tactical_board.terrain_table"],
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "flier_ignore_terrain", "kind": { "kind": "bool" }, "required": true }
          ] },
          "compiler_tags": { "spec_role": "mechanic", "system": "grid.battlefield_system" },
          "effects_template": [
            { "effect": "modify_property", "entity": "grid.unit_roster", "property": "evade", "formula": "evade + terrain_evade_bonus" },
            { "effect": "modify_property", "entity": "grid.unit_roster", "property": "def", "formula": "def + terrain_def_bonus" }
          ]
        },
        {
          "id": "terrain_binary_cover",
          "label": "二元掩体规则",
          "summary": "地形只区分掩体与非掩体，处于掩体时按固定比例减伤",
          "implications": ["地形理解成本低，可读性优先", "数值杠杆集中在单一减伤比例上"],
          "unlocks": ["sys.tactical_board.terrain_table"],
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "cover_reduction", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 0.9 }, "required": true }
          ] },
          "compiler_tags": { "spec_role": "mechanic", "system": "grid.battlefield_system" },
          "effects_template": [
            { "effect": "modify_property", "entity": "grid.unit_roster", "property": "hp", "formula": "hp - damage * (1 - {param:cover_reduction}) if in_cover" }
          ]
        }
      ]
    },
    {
      "id": "sys.tactical_board.terrain_table",
      "node_id": "grid_terrain",
      "domain": "terrain",
      "level": "L5",
      "genre_scope": "universal",
      "question": "地形效果表的结构是什么？",
      "tier_gate": "mg1_terrain_carrier",
      "skin_fields": ["id"],
      "options": [
        {
          "id": "terrain_effect_table",
          "label": "地形效果表",
          "summary": "每种地形一行：标识、移动消耗、回避加成、减伤加成、可通行性",
          "implications": ["移动消耗列被移动规则消费", "回避与减伤列被战斗公式消费"],
          "compiler_tags": { "spec_role": "entity_table", "visual_form": "sprite2d" },
          "parameter_schema": { "schema": "table",
            "columns": [
              { "key": "id", "kind": { "kind": "text" }, "required": true, "is_skin": true },
              { "key": "move_cost", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 99.0 }, "required": true },
              { "key": "evade_bonus", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 60.0 }, "required": true },
              { "key": "def_bonus", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 10.0 }, "required": true },
              { "key": "passable", "kind": { "kind": "bool" }, "required": true }
            ],
            "row_key": "id",
            "cardinality_key": "terrain_types"
          }
        },
        {
          "id": "custom_terrain_table",
          "label": "自定义地形表结构",
          "summary": "以结构化描述声明与预设不同的地形效果表结构",
          "implications": ["自定义结构需通过冻结门的结构化描述审查"],
          "is_custom": true,
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "structure_description", "kind": { "kind": "text" }, "constraint": { "constraint": "min_len", "min": 8 }, "required": true }
          ] }
        }
      ]
    },
    {
      "id": "sys.tactical_board.formation_slots",
      "domain": "tactical_board",
      "level": "L4",
      "genre_scope": "universal",
      "question": "静态站位的槽位结构怎么划分？",
      "design_question": "『站前排还是后排』这道题给玩家几行几列的答题卡？槽位结构是站位策略的定义域。",
      "tier_gate": "tb0_static_formation",
      "options": [
        {
          "id": "two_row_formation",
          "label": "前后两排",
          "summary": "队伍分前排/后排两行，行内顺序不承载机制（DQ/初代 JRPG 口径）",
          "implications": [
            "站位决策就一道二选一×人数，上手零门槛，策略深度全靠排位效果系数支撑",
            "保护关系一目了然：前排在、后排安全——阵型崩坏（前排全灭）是天然的战斗转折点",
            "横向站位（同排相邻）不承载机制，范围技的横向溅射无从表达"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.tactical_board" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "front_row_cap", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 6.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "board_unit", "property": "unit_position_state", "formula": "row = chosen_row if row_count(front) <= {param:front_row_cap}" },
            { "effect": "modify_property", "entity": "tactical_board", "property": "board_occupancy", "formula": "assign(unit, row_slot)" }
          ]
        },
        {
          "id": "cell_matrix_formation",
          "label": "格阵矩阵站位",
          "summary": "R×C 小矩阵逐格站位（3×3/4×3），行列都承载机制（皇室战争卡位/炼金工房阵形口径）",
          "implications": [
            "行管攻防衰减、列管溅射范围，范围技的形状设计空间被完全打开",
            "站位组合数按格数阶乘增长，阵型编辑器与预设方案位是必备配套",
            "格阵是 TB1 网格移动的天然前置：同一张占用表升档时直接扩容，谱系衔接无缝"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.tactical_board" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "formation_rows", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 2.0, "max": 5.0 }, "required": true },
            { "key": "formation_cols", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 2.0, "max": 5.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "board_unit", "property": "unit_position_state", "formula": "cell = chosen(row < {param:formation_rows}, col < {param:formation_cols})" },
            { "effect": "modify_property", "entity": "tactical_board", "property": "board_occupancy", "formula": "assign_exclusive(unit, cell)" }
          ]
        }
      ]
    },
    {
      "id": "sys.tactical_board.row_effect",
      "domain": "tactical_board",
      "level": "L4",
      "genre_scope": "universal",
      "question": "排位对攻防的修正按什么规则生效？",
      "design_question": "站后排换来了什么、付出了什么？排位效果是站位这道题的计分板——没有它站位就是纯摆设。",
      "tier_gate": "tb0_static_formation",
      "options": [
        {
          "id": "row_coefficient_table",
          "label": "排位系数表",
          "summary": "每排一行攻防系数（前排受击优先/后排物伤衰减），全职业统一查表",
          "implications": [
            "规则全局一致、一次学会：坦克站前、法师站后的直觉立即成立",
            "系数全局统一意味着职业差异不进站位——所有后排的收益相同，站位与构筑解耦",
            "受击优先级（敌方近战只能打前排）是系数之外必须一并定义的目标合法性规则"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.tactical_board" },
