    {
      "id": "sys.squad_command.gambit_rules",
      "domain": "squad_command",
      "level": "L4",
      "genre_scope": "universal",
      "question": "行为策略规则以什么形态编写？",
      "design_question": "给玩家一张『条件→动作』的表，还是一棵能嵌套的行为树？表平坦好上手，树表达力强但编辑器贵。",
      "tier_gate": "s3_gambit",
      "options": [
        {
          "id": "condition_action_rows",
          "label": "条件-动作规则表",
          "summary": "每行一条『条件谓词→动作』（FF12 Gambit：队友 HP<30% → 治疗），自上而下逐行匹配",
          "implications": [
            "行序即优先级，玩家用拖动排序表达策略——编辑成本极低",
            "平坦结构表达不了嵌套逻辑（如『仅当 A 且非 B 时才考虑后续三行』），复杂策略要靠冗余行堆",
            "条件谓词池与动作池是两张前置内容表，其广度直接决定本档的实际深度"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "rule_id", "kind": { "kind": "text" }, "required": true },
            { "key": "condition_expr", "kind": { "kind": "text" }, "required": true },
            { "key": "action_ref", "kind": { "kind": "text" }, "required": true },
            { "key": "row_order", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 99.0 }, "required": true }
          ], "row_key": "rule_id", "cardinality_key": "gambit_rule_rows" },
          "effects_template": [
            { "effect": "roll_check", "formula": "evaluate(condition_expr)", "difficulty_expr": "1", "on_success": [
              { "effect": "spawn_entity", "entity": "queued_command" },
              { "effect": "emit_signal", "signal": "command_signal" }
            ], "on_failure": [] }
          ]
        },
        {
          "id": "behavior_tree_graph",
          "label": "行为树图",
          "summary": "策略是一棵可嵌套的决策树（选择/序列节点），单位沿树评估落到叶子动作",
          "implications": [
            "嵌套结构能表达『战况分支下的子策略』，策略深度上限远高于平坦表",
            "树编辑器是一整个 UI 子项目，开发与教学成本都要按编辑器立项估",
            "玩家分享/复制策略树成为社区内容生态的天然抓手"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "graph",
            "node_payload": [
              { "key": "node_kind", "kind": { "kind": "enum", "variants": ["selector", "sequence", "condition", "action"] }, "required": true },
              { "key": "payload_ref", "kind": { "kind": "text" }, "required": false }
            ],
            "edge_payload": [],
            "directed": true,
            "acyclic": true,
            "entry": "single",
            "cardinality_key": "gambit_tree_nodes"
          },
          "effects_template": [
            { "effect": "change_state", "machine": "behavior_tree_cursor", "to_state": "next_matched_node" },
            { "effect": "spawn_entity", "entity": "queued_command" },
            { "effect": "emit_signal", "signal": "command_signal" }
          ]
        }
      ]
    },
    {
      "id": "sys.squad_command.gambit_arbitration",
      "domain": "squad_command",
      "level": "L4",
      "genre_scope": "universal",
      "question": "多条策略规则同时命中时如何仲裁？",
      "design_question": "两条规则都想让单位动，听谁的？独占仲裁产出确定性执行，加权随机产出带脾气的部下。",
      "tier_gate": "s3_gambit",
      "options": [
        {
          "id": "top_priority_exclusive",
          "label": "最高优先级独占",
          "summary": "命中集合里只执行序号最靠前的一条，其余静默跳过，结果完全确定",
          "implications": [
            "策略执行可复现，玩家能通过排序完全掌控单位行为——调试型玩家的最爱",
            "低序规则可能永远轮不上（被高序饿死），需要给玩家命中率统计做诊断",
            "确定性让 AI 行为可被完全预测，PVP 场景下策略表本身成为可破解对象"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "none" },
          "effects_template": [
            { "effect": "modify_rule", "target_rule": "command_rule_slot", "patch": { "patch": "add_precondition", "condition": "no_lower_row_order_rule_matched" }, "priority": 0 },
            { "effect": "emit_signal", "signal": "command_signal" }
          ]
        },
        {
          "id": "weighted_random_among_valid",
          "label": "合法项加权随机",
          "summary": "命中集合按权重随机选一条执行，权重随行序衰减，单位行为带受控随机",
          "implications": [
            "单位行为有『活物感』，同一策略表跑出不同过程，重复可看性高",
            "随机性牺牲精确控制，硬核策略玩家会感知为不听话",
            "权重衰减系数是手感旋钮：衰减陡近似独占仲裁，衰减缓近似均匀乱选"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "weight_decay_per_row", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.01, "max": 1.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "draw_from_pool", "pool_table": "matched_gambit_rules", "draw_count_expr": "1", "draw_rule": "weighted_by(row_order, decay={param:weight_decay_per_row})", "destination": "queued_command" },
            { "effect": "emit_signal", "signal": "command_signal" }
          ]
        }
      ]
    }
