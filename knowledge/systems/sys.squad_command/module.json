    {
      "id": "sys.squad_command.queue_semantics",
      "domain": "squad_command",
      "level": "L4",
      "genre_scope": "universal",
      "question": "命令队列按什么语义执行？",
      "design_question": "Shift+右键排一串命令后，新命令是排在队尾还是把队伍掐了插队？顺序队列卖规划，抢占卖响应。",
      "tier_gate": "s2_command_queue",
      "options": [
        {
          "id": "fifo_execution",
          "label": "顺序执行队列",
          "summary": "命令按入队顺序依次执行，前一条完成才开始下一条，新命令默认追加队尾",
          "implications": [
            "玩家可以预排长链（移动→攻击→巡逻）后把注意力交给别处，规划价值高",
            "战况突变时排好的队列反而是负债，清队列的操作成本必须足够低",
            "队列可视化（路径线/序号标记）是该口径可用性的前提，不是可选项"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "max_queue_length", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 50.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "spawn_entity", "entity": "queued_command" },
            { "effect": "modify_property", "entity": "queued_command", "property": "queue_order", "formula": "tail_position if queue_length < {param:max_queue_length}" },
            { "effect": "schedule", "timing": "delayed", "amount_expr": "sum(preceding_commands_duration)", "unit": "seconds", "inner": [
              { "effect": "emit_signal", "signal": "command_signal" }
            ] }
          ]
        },
        {
          "id": "priority_preempt",
          "label": "优先级抢占",
          "summary": "命令带优先级，高优先级新命令中断当前执行并插到队首，低的排队等待",
          "implications": [
            "紧急响应（集火/撤退）不需要清队列，操作的即时性显著更好",
            "优先级表是新的设计负担：哪类命令天然高优、玩家能否手动改优先级都要定义",
            "被抢占命令的恢复语义（作废还是挂起续跑）是隐藏规则，必须显式声明"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "priority_levels", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 2.0, "max": 9.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "spawn_entity", "entity": "queued_command" },
            { "effect": "roll_check", "formula": "new_command_priority", "difficulty_expr": "executing_command_priority", "on_success": [
              { "effect": "change_state", "machine": "executing_command", "to_state": "suspended" },
              { "effect": "emit_signal", "signal": "command_signal" }
            ], "on_failure": [
              { "effect": "modify_property", "entity": "queued_command", "property": "queue_order", "formula": "insert_by_priority(priority, levels={param:priority_levels})" }
            ] }
          ]
        }
      ]
    },
