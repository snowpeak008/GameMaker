            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "auto_behavior_rule", "kind": { "kind": "text" }, "required": true }
          ], "row_key": "stance_id", "cardinality_key": "stance_rows" },
          "effects_template": [
            { "effect": "attach", "modifier_id": "stance_behavior", "target": "squad_assignment", "duration_expr": "while(stance_selected == stance_id)", "priority": 0 },
            { "effect": "emit_signal", "signal": "command_signal" }
          ]
        },
        {
          "id": "waypoint_patrol",
          "label": "路径点巡逻",
          "summary": "玩家铺设路径点序列，单位循环沿点移动并在途中按遭遇规则响应",
          "implications": [
            "巡逻把空间控制变成可铺设的内容，防守布置有了持续表达位",
            "途中遭遇的响应规则（追多远、何时归位）是巡逻体验的真实主体，路径只是壳",
            "路径点的编辑/可视化成本高，移动端交互尤其昂贵"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.squad_command" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "max_waypoints", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 2.0, "max": 20.0 }, "required": true },
            { "key": "leash_distance", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 100.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "schedule", "timing": "periodic", "amount_expr": "per_waypoint_travel_time", "unit": "seconds", "inner": [
              { "effect": "emit_signal", "signal": "command_signal" }
            ] },
            { "effect": "modify_property", "entity": "queued_command", "property": "patrol_loop", "formula": "cycle(waypoints, max={param:max_waypoints}, leash={param:leash_distance})" }
          ]
        }
      ]
