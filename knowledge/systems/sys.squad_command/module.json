            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "auto_assign_rule", "kind": { "kind": "text" }, "required": true }
          ], "row_key": "role_id", "cardinality_key": "role_group_rows" },
          "effects_template": [
            { "effect": "modify_property", "entity": "squad_assignment", "property": "group_index", "formula": "role_of(unit, auto_assign_rule)" },
            { "effect": "emit_signal", "signal": "roster_signal" }
          ]
