{
  "module_id": "sys.rule_modifier_collect",
  "semver": "1.0.0",
  "label_zh": "规则修饰器收集",
  "summary": "收集常驻规则修饰器（遗物/饰品/被动）并按叠加序改写他系统规则的系统（清单 #14）。ModifyRule{RulePatch, priority} 是本模块的核心表达位（定稿 §5.3 指令 7）：同目标多修饰器按 priority 结算、同序按机制 id 字典序 tie-break，C4 把叠加序渲染进 GWT——力量类（加法修正，priority 靠前）先于乘算类（乘法修正，priority 靠后）结算。谱系三档：战利品架（纯收集展示）→ 规则修补（W10 重，尖塔遗物档）→ 条件触发网。边界三测试自检：T1 独占状态=修饰器收藏表 + 生效栈状态（谁被收集、谁在生效、以什么序，只有本系统能写）；T2 可摘除=摘除后战斗/构筑规则退回未修饰基线即自洽（只删接口边，不迫使目标系统改写内部规则——规则挂点语义保证）；T3 名词转换=消费回合事件与目标系统的规则挂点，产出修饰器实体/生效栈/收集事件。与 #13 局内构筑边界：#13 的卡牌是回合内消耗性行动、#14 的修饰器是常驻规则改写，状态所有权（牌库表 vs 修饰器收藏表）与生效时域（出牌瞬时 vs 持续常驻）都不同，不合并。",
  "nouns": [
    {
      "id": "relic_entity",
      "kind": { "kind": "entity_class" },
      "label_zh": "修饰器实体",
      "summary": "有行标识与属性列的修饰器实例（遗物/饰品）。修饰器收藏表是本系统独占状态的载体（T1 锚点）。"
    },
    {
      "id": "modifier_stack_state",
      "kind": { "kind": "property", "of": "relic_collection" },
      "label_zh": "修饰器生效栈",
      "summary": "当前生效修饰器的有序集合：每项记录作用靶规则、补丁类型与 priority。叠加序的唯一真相源——同 priority 冲突按机制 id 字典序 tie-break（确定性纪律）。"
    },
    {
      "id": "relic_signal",
      "kind": { "kind": "signal" },
      "label_zh": "修饰器收集事件",
      "summary": "一次修饰器获得/失去的时点信号，载荷为修饰器与来源渠道。统计、成就与收藏 UI 监听它。"
    }
  ],
  "interface": {
    "provides": ["relic_entity", "modifier_stack_state", "relic_signal"],
    "consumes": [
      "sys.turn_combat.turn_signal"
    ],
    "modifies": [
      "sys.turn_combat.combat_rule_slot",
      "sys.run_deckbuild.deck_rule_slot"
    ]
  },
  "mda": {
    "mechanics_summary": "修饰器获取渠道/收藏表/加法修正（力量类）/乘法修正（乘算类）/叠加序 priority 声明/条件触发前置的机制群。",
    "dynamics_notes": [
      "修饰器常驻生效使每次获取都永久改变局内规则地形，玩家的路线规划围绕『下一个遗物』展开（信号：遗物节点选择率、见宝箱绕路率）",
      "加法与乘法修正的叠加序可感知后，高手开始计算修正链的实际期望而非面板数字（信号：社区伤害计算器出现、同遗物组合的取舍讨论）",
      "条件触发档起，修饰器之间形成触发网，单件收集从线性加强变为组合发现（信号：特定遗物组合的胜率异常聚类）"
    ],
    "aesthetics_primary": ["发现", "表达"]
  },
