            ], "on_failure": [
              { "effect": "change_state", "machine": "batch_selection", "to_state": "included" },
              { "effect": "despawn_entity", "entity": "stored_item_entry" }
            ] }
          ]
        },
        {
          "id": "manual_item_lock",
          "label": "手动上锁白名单",
          "summary": "玩家逐件上锁，锁定物品对一切批量与出售操作免疫，系统不自动划线",
