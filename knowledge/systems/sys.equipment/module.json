  "decision_points": [
    {
      "id": "sys.equipment.slot_rule",
      "domain": "equipment",
      "level": "L4",
      "genre_scope": "universal",
      "question": "装备槽位按什么规则划分与互斥？",
      "design_question": "玩家一次能穿多少件、按什么规则互斥？这决定『换装』这个动词的最小操作单元。",
      "tier_gate": "e0_stat_bonus",
      "options": [
        {
          "id": "fixed_part_slots",
          "label": "固定部位槽",
          "summary": "每个身体部位一个槽（武器/头/胸/腿/饰品），穿戴即替换同槽旧装备",
          "implications": [
            "换装决策被切成逐部位的两两比较，认知负担低",
            "部位数即装备维度数，属性预算按部位切分",
            "双持/双戒指等例外要在槽表里显式建模而不是硬编码"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "slot_count", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 2.0, "max": 12.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "combat_unit", "property": "combat_attribute", "formula": "attribute + sum(equipped_bonus_by_slot, slots={param:slot_count})" },
            { "effect": "emit_signal", "signal": "equip_signal" }
          ]
        },
        {
          "id": "shared_budget_slots",
          "label": "通用预算槽",
          "summary": "不分部位，装备占用负重/格数预算，预算内可自由混搭同类多件",
          "implications": [
            "构筑自由度显著高于部位槽：三件戒指流、全饰品流成为合法构筑",
            "平衡从『逐部位对比』变成『预算内背包问题』，数值组合爆炸需要预算上限压制",
            "UI 必须展示预算余量，否则玩家无法做取舍"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "budget_cap", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 1.0, "max": 999.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "combat_unit", "property": "combat_attribute", "formula": "attribute + sum(equipped_bonus) where total_weight <= {param:budget_cap}" },
            { "effect": "emit_signal", "signal": "equip_signal" }
          ]
        }
      ]
    },
    {
      "id": "sys.equipment.quality_tier",
      "domain": "equipment",
      "level": "L4",
      "genre_scope": "universal",
      "question": "品质分层如何定义各档强度差？",
      "design_question": "白装到橙装之间隔着什么——是数值倍率还是可能性空间？",
      "tier_gate": "e1_quality_affix",
      "options": [
        {
          "id": "stat_multiplier_tiers",
          "label": "数值倍率品质",
          "summary": "品质档按属性倍率递增，高品质=同部位数值更高，词条数固定",
          "implications": [
            "品质即战力，掉落高亮瞬间可读，适合节奏快的刷宝循环",
            "低品质装备在同等级下被严格支配，无保留价值，分解回收压力大",
            "倍率步长决定档间跳变感：步长过小品质失去意义，过大则中间档形同虚设"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "tier_key", "kind": { "kind": "text" }, "required": true },
            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "stat_multiplier", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.5, "max": 10.0 }, "required": true }
          ], "row_key": "tier_key", "cardinality_key": "quality_tiers" },
          "effects_template": [
            { "effect": "modify_property", "entity": "equipment_entity", "property": "stat_budget", "formula": "base_stats(slot, item_level) * stat_multiplier(tier_key)" }
          ]
        },
        {
          "id": "affix_capacity_tiers",
          "label": "词条容量品质",
          "summary": "品质不改基础数值，只决定随机词条的条数上限与可roll词条池层级",
          "implications": [
            "高品质是更大的可能性空间而非更大的数字，白装出极品词条仍可能毕业",
            "装备评估从看颜色变成读词条，决策深度高、上手门槛也高",
            "词条池分层表成为品质系统的真实载体，维护成本转移到词条池"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "tier_key", "kind": { "kind": "text" }, "required": true },
            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "max_affixes", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 8.0 }, "required": true }
          ], "row_key": "tier_key", "cardinality_key": "quality_tiers" },
          "effects_template": [
            { "effect": "modify_property", "entity": "equipment_entity", "property": "affix_capacity", "formula": "max_affixes(tier_key)" }
          ]
        }
      ]
    },
    {
      "id": "sys.equipment.affix_roll",
      "domain": "equipment",
      "level": "L4",
      "genre_scope": "universal",
      "question": "随机词条按什么规则生成？",
      "design_question": "一件装备落地那一刻，它的词条是怎么被决定的——纯权重抽取，还是受部位/类型约束？",
      "tier_gate": "e1_quality_affix",
      "options": [
        {
          "id": "weighted_pool_roll",
          "label": "全池权重抽取",
          "summary": "从统一词条池按权重抽 N 条，每条在自身数值区间内二次 roll",
          "implications": [
            "词条池单表维护，新词条入池即全装备生效",
            "会产生法杖出格挡、弓出近战吸血这类语义错位组合，需要接受或靠数值淡化",
            "双层随机（抽条+roll值）拉开极品与普通的距离，赌狗体验强"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "affix_id", "kind": { "kind": "text" }, "required": true },
            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "quality", "kind": { "kind": "text" }, "required": true },
            { "key": "weight", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 1000.0 }, "required": true },
            { "key": "min_value", "kind": { "kind": "float" }, "required": true },
            { "key": "max_value", "kind": { "kind": "float" }, "required": true }
          ], "row_key": "affix_id", "cardinality_key": "affix_pool_rows" },
          "effects_template": [
            { "effect": "draw_from_pool", "pool_table": "affix_pool", "draw_count_expr": "affix_count(quality)", "draw_rule": "weighted_without_replacement", "destination": "equipment_entity.affixes" },
            { "effect": "modify_property", "entity": "equipment_entity", "property": "affix_value", "formula": "roll(min_value, max_value) per drawn affix" }
          ]
        },
        {
          "id": "tag_constrained_roll",
          "label": "标签约束抽取",
          "summary": "词条带部位/武器类型标签，抽取前先按装备标签过滤池，再按权重抽取",
          "implications": [
            "消灭语义错位组合，每个部位的词条空间可被单独设计与平衡",
            "词条池要维护标签矩阵，新部位入库时全池标签需回查",
            "过滤后子池变小，同部位词条重复率升高，需要更大的池子兜底多样性"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "affix_id", "kind": { "kind": "text" }, "required": true },
            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "quality", "kind": { "kind": "text" }, "required": true },
            { "key": "slot_tags", "kind": { "kind": "text" }, "required": true },
            { "key": "weight", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 1000.0 }, "required": true },
            { "key": "min_value", "kind": { "kind": "float" }, "required": true },
            { "key": "max_value", "kind": { "kind": "float" }, "required": true }
          ], "row_key": "affix_id", "cardinality_key": "affix_pool_rows" },
          "effects_template": [
            { "effect": "draw_from_pool", "pool_table": "affix_pool", "draw_count_expr": "affix_count(quality)", "draw_rule": "weighted_filtered_by(slot_tags)", "destination": "equipment_entity.affixes" },
            { "effect": "modify_property", "entity": "equipment_entity", "property": "affix_value", "formula": "roll(min_value, max_value) per drawn affix" }
          ]
        }
      ]
    },
    {
      "id": "sys.equipment.skill_trigger",
      "domain": "equipment",
      "level": "L4",
      "genre_scope": "universal",
      "question": "装备技能以什么条件触发？",
      "design_question": "装备上的技能是玩家按出来的、打出来的、还是属性堆出来的？三种触发口径塑造完全不同的构筑方向。",
      "tier_gate": "e2_skill_build",
      "options": [
        {
          "id": "proc_on_event",
          "label": "事件概率触发",
          "summary": "命中/击杀/受击等战斗事件按概率触发装备技能（proc），带内置冷却防刷屏",
          "implications": [
            "构筑围绕触发频率成型：攻速流、多段命中流天然与 proc 装协同",
            "概率触发的爽点是意外性，但关键时刻不触发的挫败也来自同一机制",
            "内置冷却是平衡阀：没有它，攻速堆叠会让 proc 期望失控"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.equipment" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "proc_chance", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 1.0 }, "required": true },
