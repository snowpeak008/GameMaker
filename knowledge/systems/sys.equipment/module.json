{
  "module_id": "sys.equipment",
  "semver": "1.0.0",
  "label_zh": "装备",
  "summary": "可穿戴实体对角色属性/能力的修饰。全谱系 E0-E6：纯属性加成 → 品质词条 → 技能BD → 宝石镶嵌 → 合成/冶炼 → 升级/强化 → 套装/幻化（幻化为纯皮层，落 skin_fields 不占机制点）。",
  "nouns": [
    {
      "id": "equipment_entity",
      "kind": { "kind": "entity_class" },
      "label_zh": "装备实体",
      "summary": "有行标识与属性列的装备实例：槽位、品质、词条、孔位、强化等级都是它的列。"
    },
    {
      "id": "combat_attribute",
      "kind": { "kind": "property", "of": "combat_unit" },
      "label_zh": "战斗属性",
      "summary": "装备修改的角色属性（攻击/防御/速度等），宿主为战斗单位。"
    },
    {
      "id": "equip_signal",
      "kind": { "kind": "signal" },
      "label_zh": "穿戴事件",
      "summary": "穿脱装备的时点信号，载荷为装备实体与槽位；供任务/成就/套装聚合监听。"
    },
    {
      "id": "drop_rule_slot",
      "kind": { "kind": "rule_slot" },
      "label_zh": "掉落规则挂点",
      "summary": "允许他系统 ModifyRule 作用的装备掉落规则位（如幸运词条提升掉落品质权重）。"
    },
    {
      "id": "enhance_pity",
      "kind": { "kind": "resource" },
      "label_zh": "强化保底计数",
      "summary": "强化失败累积的保底进度，有余额语义（累满必成，成功后清零）。"
    }
  ],
  "interface": {
    "provides": ["equipment_entity", "equip_signal", "drop_rule_slot"],
    "consumes": [
      "sys.loot.drop_table",
      "sys.loot.gem_entity",
      "sys.loot.material_entity",
      "sys.economy.currency_main"
    ],
    "modifies": ["combat_attribute"]
  },
  "mda": {
    "mechanics_summary": "穿戴槽位/品质分层/词条随机/技能触发与绑定/孔位镶嵌/配方合成/分解回收/强化概率与保护/套装聚合的机制群。",
    "dynamics_notes": [
      "玩家在新旧装备对比中反复触发替换决策（信号：装备替换率、背包内滞留装备数）",
      "E2 档以上出现围绕技能触发条件的构筑成型（信号：同一 build 标签下装备组合的重复出现率）",
      "E4 档以上分解-合成回路驱动拾取行为从『捡好的』变为『全都捡』（信号：拾取率、材料库存曲线）"
    ],
    "aesthetics_primary": ["挑战", "表达"]
  },
