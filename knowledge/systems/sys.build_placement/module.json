{
  "module_id": "sys.build_placement",
  "semver": "1.0.0",
  "label_zh": "建造放置",
  "summary": "将实体按空间规则放入世界格/槽位并产生持续功能的系统（附录 G1）。全谱系 BP0-BP3：预设槽位放置（塔防塔位）→ 网格自由放置+邻接加成 → 多层结构+支撑规则表+蓝图复制 → 可破坏地形+建造经济闭环（拆除返还/维护费）。",
  "nouns": [
    {
      "id": "world_grid_occupancy",
      "kind": { "kind": "property", "of": "world_map" },
      "label_zh": "世界格归属表",
      "summary": "本系统独占的核心状态：哪格放了什么，含朝向与层级列。所有合法性/邻接/支撑查询都以它为唯一真相。"
    },
    {
      "id": "placement_command",
      "kind": { "kind": "signal" },
      "label_zh": "放置指令",
      "summary": "玩家/AI 侧发起的放置请求信号，载荷为目标格、放置物类型与朝向；本系统消费它做合法性裁定。"
    },
    {
      "id": "placed_structure",
      "kind": { "kind": "entity_class" },
      "label_zh": "放置态实体",
      "summary": "落成后的建筑/塔实例：位置、朝向、层级、耐久、在建/落成/停机状态都是它的列。"
    },
    {
      "id": "adjacency_rule_slot",
      "kind": { "kind": "rule_slot" },
      "label_zh": "邻接规则挂点",
      "summary": "邻接加成规则的可修改挂点：允许他系统 ModifyRule 作用（如科技研究放大邻接系数），也是编译器挂邻接修饰器的锚。"
    },
    {
      "id": "structure_function_value",
      "kind": { "kind": "property", "of": "placed_structure" },
      "label_zh": "放置物功能值",
      "summary": "邻接修饰器作用的目标属性：塔的攻速、农田的产量、工厂的吞吐——放置物对外输出功能的量化口径。"
    },
    {
      "id": "placement_done_signal",
      "kind": { "kind": "signal" },
      "label_zh": "放置落成事件",
      "summary": "一次放置最终落成的时点信号，载荷为放置态实体与格位；供任务/引导/成就监听。"
    }
  ],
  "interface": {
    "provides": ["placed_structure", "placement_done_signal", "adjacency_rule_slot"],
    "consumes": [
      "placement_command",
      "sys.loot.material_entity",
      "sys.economy.currency_main"
    ],
    "modifies": ["world_grid_occupancy", "structure_function_value"]
  },
  "mda": {
    "mechanics_summary": "放置合法性裁定/格占用口径/结算时点/网格拓扑/邻接加成/朝向端口/支撑规则表/蓝图复制/拆除返还/维护费/可破坏地形的机制群。",
    "dynamics_notes": [
      "玩家在放置预览中反复试探合法边界（信号：预览驳回率、单次放置确认前的位置调整次数）",
      "BP1 档以上出现布局定式与抄作业传播（信号：同型布局模板在玩家群体中的重复出现率）",
      "BP3 档拆改频率反映经济阀设置是否合理（信号：拆除/新建比、维护欠费停机率）"
    ],
    "aesthetics_primary": ["表达", "挑战"]
  },
  "heaviness": {
    "tiers": [
      {
        "id": "bp0_preset_slots",
        "label_zh": "BP0 预设槽位放置",
        "rating": { "m": 1, "d": 1, "c": 1, "p": 1, "o": 0 },
        "p_floor": 1,
        "interface_floor": 2,
        "activates": [
          "sys.build_placement.slot_legality",
          "sys.build_placement.occupancy_rule",
          "sys.build_placement.build_cost_timing"
        ],
        "inductions": [],
        "summary": "塔防塔位口径：世界预留放置位，请求进来只做合法性检查与占位结算。C≥2（consumes 放置指令与货币；modifies 格归属表）。"
      },
      {
        "id": "bp1_grid_adjacency",
        "label_zh": "BP1 +网格自由放置与邻接加成",
        "rating": { "m": 2, "d": 2, "c": 1, "p": 2, "o": 1 },
        "p_floor": 2,
        "interface_floor": 3,
        "activates": [
          "sys.build_placement.slot_legality",
          "sys.build_placement.occupancy_rule",
          "sys.build_placement.build_cost_timing",
          "sys.build_placement.grid_topology",
          "sys.build_placement.adjacency_rule",
          "sys.build_placement.facing_rule"
        ],
        "inductions": [],
        "summary": "模拟经营/农场布局口径：放置空间连续开放，邻接加成让『放在哪』成为会话级重复决策，P 升至 2。"
      },
      {
        "id": "bp2_multilayer_blueprint",
        "label_zh": "BP2 +多层结构、支撑规则表与蓝图复制",
        "rating": { "m": 3, "d": 2, "c": 2, "p": 3, "o": 2 },
        "p_floor": 3,
        "interface_floor": 5,
        "activates": [
          "sys.build_placement.slot_legality",
          "sys.build_placement.occupancy_rule",
          "sys.build_placement.build_cost_timing",
          "sys.build_placement.grid_topology",
          "sys.build_placement.adjacency_rule",
          "sys.build_placement.facing_rule",
          "sys.build_placement.support_rule",
          "sys.build_placement.blueprint_copy"
        ],
        "inductions": [
          {
            "when_tier": "bp2_multilayer_blueprint",
            "target": { "noun_provided": "material_entity" },
            "min_tier": "",
            "reason": "蓝图复制与多层结构把材料吞吐放大一个量级：任一实例必须 provides 材料实体（掉落/采集/商店任一来源即满足——析取语义）"
          }
        ],
        "summary": "Minecraft 级建造：多层占格与支撑合法性由规则表静态裁定，蓝图把成片布局变成可复制资产。射程边界（用户特别检查所划）：物理坍塌动力学出射程，本档只承诺支撑**规则表**——『立不立得住』按表裁定，『怎么塌』不模拟。"
      },
      {
        "id": "bp3_destructible_economy",
        "label_zh": "BP3 +可破坏地形与建造经济闭环",
        "rating": { "m": 3, "d": 3, "c": 3, "p": 3, "o": 3 },
        "p_floor": 3,
        "interface_floor": 7,
        "activates": [
          "sys.build_placement.slot_legality",
          "sys.build_placement.occupancy_rule",
          "sys.build_placement.build_cost_timing",
          "sys.build_placement.grid_topology",
          "sys.build_placement.adjacency_rule",
          "sys.build_placement.facing_rule",
          "sys.build_placement.support_rule",
          "sys.build_placement.blueprint_copy",
          "sys.build_placement.demolish_refund",
          "sys.build_placement.upkeep_model",
          "sys.build_placement.terrain_destruct"
        ],
        "inductions": [
          {
            "when_tier": "bp3_destructible_economy",
            "target": { "module": "sys.economy" },
            "min_tier": "recycle_loop",
            "reason": "拆除返还与维护费是货币回收回路的两个终端：经济系统必须达到回收回路档，否则建造侧的沉没与返还没有账本承接"
          }
        ],
        "summary": "建造经济成环：地形可破坏进资源经济，拆除返还与维护费给建造装上回收阀。C/O 推满进入极重档。"
      }
    ]
  },
  "decision_points": [
    {
      "id": "sys.build_placement.slot_legality",
      "domain": "build_placement",
      "level": "L4",
      "genre_scope": "universal",
      "question": "一次放置请求按什么规则裁定合法？",
      "design_question": "玩家把塔/建筑拖到某处松手的那一刻，系统查什么说『行』或『不行』？合法性口径决定放置是分配题还是空间创造题。",
      "tier_gate": "bp0_preset_slots",
      "options": [
        {
          "id": "preset_slot_whitelist",
          "label": "预设槽位白名单",
          "summary": "世界预先烘焙可放置槽位表，请求落在开放槽位即合法（塔防塔位口径）",
          "implications": [
            "关卡设计完全控制放置空间，每图的放置预算=槽位数，平衡可逐图核算",
            "玩家决策收敛为『哪个槽放哪个塔』的分配问题，无空间创造成分",
            "槽位表是关卡数据不是机制：加图不改规则，但槽位解锁节奏要与波次难度联动"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "slot_id", "kind": { "kind": "text" }, "required": true },
            { "key": "slot_tag", "kind": { "kind": "text" }, "required": true },
            { "key": "enabled_from_wave", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 999.0 }, "required": true }
          ], "row_key": "slot_id", "cardinality_key": "preset_slot_rows" },
          "effects_template": [
            { "effect": "roll_check", "formula": "slot_open(target_slot)", "difficulty_expr": "0", "on_success": [
              { "effect": "spawn_entity", "entity": "placed_structure" },
              { "effect": "modify_property", "entity": "world_map", "property": "world_grid_occupancy", "formula": "claim(target_slot, structure_id)" },
              { "effect": "emit_signal", "signal": "placement_done_signal" }
            ], "on_failure": [
              { "effect": "emit_signal", "signal": "placement_rejected" }
            ] }
          ]
        },
        {
          "id": "predicate_rule_check",
          "label": "谓词规则现场裁定",
          "summary": "无预设槽位，按谓词链（地形类型∈允许集/无碰撞/在归属区域内/间距约束）对任意格现场裁定",
          "implications": [
            "放置空间连续开放，玩家能发明设计者没预料的布局——表达美学的来源",
            "谓词链每加一条，全地图合法域整体变化，关卡侧失去逐点控制权",
            "放置预览必须给实时红/绿反馈并说明驳回原因，否则谓词链越长挫败越深"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "predicate_id", "kind": { "kind": "text" }, "required": true },
            { "key": "rule_expr", "kind": { "kind": "text" }, "required": true },
            { "key": "failure_hint", "kind": { "kind": "text" }, "required": true, "is_skin": true }
          ], "row_key": "predicate_id", "cardinality_key": "legality_predicate_rows" },
          "effects_template": [
            { "effect": "roll_check", "formula": "all_predicates_pass(target_cell, structure_type)", "difficulty_expr": "0", "on_success": [
              { "effect": "spawn_entity", "entity": "placed_structure" },
              { "effect": "modify_property", "entity": "world_map", "property": "world_grid_occupancy", "formula": "claim(target_cell, structure_id)" },
              { "effect": "emit_signal", "signal": "placement_done_signal" }
            ], "on_failure": [
              { "effect": "emit_signal", "signal": "placement_rejected" }
            ] }
          ]
        }
      ]
    },
    {
      "id": "sys.build_placement.occupancy_rule",
      "domain": "build_placement",
      "level": "L4",
      "genre_scope": "universal",
      "question": "一个世界格能同时容纳多少放置物？",
      "design_question": "格归属表的每个格子是独木桥还是多层公寓？占用口径决定纵向组合玩法是否存在。",
      "tier_gate": "bp0_preset_slots",
      "options": [
        {
          "id": "exclusive_cell",
          "label": "一格一物",
          "summary": "每格唯一归属，重叠即非法；归属表是一张平面表",
          "implications": [
            "冲突裁定 O(1)，归属表两态（空/占），实现与玩家心智都最简",
            "布局密度上限=格数，优化是纯装箱问题",
            "地基+建筑+装饰这类纵向组合必须做成实体合成（一个实体多个部件），不能靠叠格表达"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "occupancy_table_id", "kind": { "kind": "text" }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "{param:occupancy_table_id}", "property": "world_grid_occupancy", "formula": "claim_exclusive(cell, structure_id) fail_if_occupied" }
          ]
        },
        {
          "id": "layered_coexist",
          "label": "分层共存",
          "summary": "每格按图层表（地基/主体/附件/装饰）分层，同层互斥、异层共存",
          "implications": [
            "同一格的纵向组合成为新的表达维度（地板+机器+顶棚灯）",
            "归属表变三维（格×层），所有邻接/支撑查询都要带层参数，复杂度全面上浮",
            "图层定义表是全局词汇：加一层=全部放置物要声明归层，要走变更纪律"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "layer_id", "kind": { "kind": "text" }, "required": true },
            { "key": "label", "kind": { "kind": "text" }, "required": true, "is_skin": true },
            { "key": "z_order", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 15.0 }, "required": true }
          ], "row_key": "layer_id", "cardinality_key": "cell_layer_rows" },
          "effects_template": [
            { "effect": "modify_property", "entity": "world_map", "property": "world_grid_occupancy", "formula": "claim_layer(cell, layer_of(structure_type), structure_id) fail_if_layer_occupied" }
          ]
        }
      ]
    },
    {
      "id": "sys.build_placement.build_cost_timing",
      "domain": "build_placement",
      "level": "L4",
      "genre_scope": "universal",
      "question": "放置的资源结算与功能生效发生在什么时刻？",
      "design_question": "钱在松手瞬间扣掉且建筑立即工作，还是先立脚手架再等施工完成？时点口径决定建造是即时战术还是排程计划。",
      "tier_gate": "bp0_preset_slots",
      "options": [
        {
          "id": "instant_build",
          "label": "即时结算即时生效",
          "summary": "松手扣资源，建筑立即落成生效（塔防/RTS 微操口径）",
          "implications": [
            "放置是战术动作：战斗中可以反应式补防，操作深度进会话层",
            "无在建状态，格归属表只有两态，实现与心智成本最低",
            "建造速度不存在，无法作为科技/加成/差异化维度使用"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "tower_table_id", "kind": { "kind": "text" }, "required": true }
          ] },
          "effects_template": [
            { "effect": "consume_resource", "resource": "sys.economy.currency_main", "formula": "build_cost(structure_type)" },
            { "effect": "spawn_entity", "entity": "{param:tower_table_id}" },
            { "effect": "emit_signal", "signal": "placement_done_signal" }
          ]
        },
        {
          "id": "construction_period",
          "label": "施工期建造",
          "summary": "松手立即占格进入在建态，经过施工时间（或工人劳动）后落成",
          "implications": [
            "建造进入排程规划：提前量与优先级成为核心技能，P 维价值上移",
            "在建态是第三种格状态，可被打断/加速/摧毁，衍生一整族规则",
            "时间与资源双轴定价，平衡空间更大，但『等待』的体验成本要用进度反馈支付"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "base_build_seconds", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.5, "max": 600.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "consume_resource", "resource": "sys.economy.currency_main", "formula": "build_cost(structure_type)" },
            { "effect": "change_state", "machine": "placed_structure.build_state", "to_state": "under_construction" },
            { "effect": "schedule", "timing": "delayed", "amount_expr": "{param:base_build_seconds}", "unit": "seconds", "inner": [
              { "effect": "change_state", "machine": "placed_structure.build_state", "to_state": "built" },
              { "effect": "emit_signal", "signal": "placement_done_signal" }
            ] }
          ]
        }
      ]
    },
    {
      "id": "sys.build_placement.grid_topology",
      "domain": "build_placement",
      "level": "L4",
      "genre_scope": "universal",
      "question": "自由放置基于什么空间离散口径？",
      "design_question": "世界被切成正交方格，还是连续坐标加碰撞盒？切法决定『对齐』的含义与邻接的定义域。",
      "tier_gate": "bp1_grid_adjacency",
      "options": [
        {
          "id": "square_grid_footprint",
          "label": "方格+占地脚印",
          "summary": "世界为正交方格，建筑按 W×H 脚印占格并自动对齐",
          "implications": [
            "邻接/支撑/寻路全部落在整数格上，规则表离散可枚举、可审计",
            "脚印表即建筑的空间词汇：大建筑=多格，旋转=脚印转置",
            "斜排/曲线布局不可表达，世界呈现格状肌理——美术风格要顺着格走"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "table", "columns": [
            { "key": "structure_type", "kind": { "kind": "text" }, "required": true },
            { "key": "footprint_w", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 16.0 }, "required": true },
            { "key": "footprint_h", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 16.0 }, "required": true }
          ], "row_key": "structure_type", "cardinality_key": "footprint_rows" },
          "effects_template": [
            { "effect": "modify_property", "entity": "world_map", "property": "world_grid_occupancy", "formula": "claim_rect(anchor_cell, footprint_w(structure_type), footprint_h(structure_type))" }
          ]
        },
        {
          "id": "continuous_anchor_collision",
          "label": "连续锚点+碰撞盒",
          "summary": "无格，建筑按连续坐标放置，碰撞盒互不重叠即可（动物园之星/城市天际线口径）",
          "implications": [
            "布局自由度最大，斜排、曲线街道、贴合地形的有机布局成为可能",
            "邻接不能数格：一切邻接规则改为半径查询，加成表全部带距离参数",
            "吸附/网格线等对齐辅助从机制降为 UI 服务，不做则杂乱布局惩罚整体美感"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.build_placement" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "snap_radius", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 4.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "world_map", "property": "world_grid_occupancy", "formula": "claim_region(position_snapped({param:snap_radius}), collision_box(structure_type))" }
          ]
        }
      ]
    },
    {
      "id": "sys.build_placement.adjacency_rule",
      "domain": "build_placement",
      "level": "L4",
      "genre_scope": "universal",
      "question": "邻接加成按什么规则计算？",
      "design_question": "『放在一起更好』的数学形态是数邻居个数，还是查特定组合表？前者奖励密度，后者奖励配方。",
      "tier_gate": "bp1_grid_adjacency",
      "options": [
        {
          "id": "neighbor_count_scaling",
          "label": "同类计数加成",
          "summary": "数同类邻居个数，按曲线换算加成（文明区域/农田连片口径）",
          "implications": [
            "规则一句话可传达，玩家自发形成聚类布局的直觉",
