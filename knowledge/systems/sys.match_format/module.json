    {
      "id": "sys.match_format.bracket_shape",
      "domain": "match_format",
      "level": "L4",
      "genre_scope": "universal",
      "question": "淘汰晋级树采用什么构型？",
      "design_question": "输一场就回家，还是败者组再给一条命？树的构型决定『一场爆冷』能不能杀死整个赛事最强者。",
      "tier_gate": "mf2_elimination_bracket",
      "options": [
        {
          "id": "single_elimination",
          "label": "单败淘汰树",
          "summary": "输即出局，log2(N) 轮决出冠军",
          "implications": [
            "每场皆生死，张力最大、赛程最短，参赛规模可以做很大（糖豆人 60 人逐轮筛）",
            "强者一次失手即出局，方差极大——冠军含金量与爆冷戏剧性同源",
            "半数参赛者首轮即出局，陪跑体验差，需要副赛/复活赛垫底"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.match_format" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "bracket_size", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 4.0, "max": 256.0 }, "required": true },
            { "key": "participant_table_id", "kind": { "kind": "text" }, "required": true }
          ] },
          "effects_template": [
            { "effect": "change_state", "machine": "match_participant.bracket_state", "to_state": "eliminated_on_loss" },
            { "effect": "modify_property", "entity": "{param:participant_table_id}", "property": "advancement_state", "formula": "advance_winner_to(next_round_slot({param:bracket_size}))" }
          ]
        },
        {
          "id": "double_elimination",
          "label": "双败淘汰树",
          "summary": "首败落入败者组，再败才出局；总决赛胜者组选手带一条命优势",
          "implications": [
            "一次爆冷杀不死最强者，冠军成色更稳，竞技公信力高",
            "对局总量近乎翻倍，赛程与转播成本同步翻倍",
            "败者组一路打上来的翻盘叙事是双败制独有的故事引擎，但胜者组决赛失利者的『白赢一场』争议永存"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.match_format" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "grand_final_advantage", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 1.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "roll_check", "formula": "loss_count(participant)", "difficulty_expr": "2", "on_success": [
              { "effect": "change_state", "machine": "match_participant.bracket_state", "to_state": "eliminated" }
            ], "on_failure": [
              { "effect": "modify_property", "entity": "match_participant", "property": "advancement_state", "formula": "route_to(losers_bracket if loss_count == 1 else winners_bracket)" }
            ] }
          ]
        },
        {
          "id": "round_robin_points",
          "label": "循环积分晋级",
          "summary": "组内人人互打按积分排名，前 K 名晋级（自走棋 8 人循环/小组赛口径）",
          "implications": [
            "无一轮游：每人都打满小组场次，参与量兜底、匹配压力低",
            "积分制下末轮可能出现默契球/放水局，同刻开赛与判定链是标准解毒剂",
            "对局总量 O(N²)，组的规模上限被时长硬约束——8-10 人是实践甜点"
          ],
          "compiler_tags": { "spec_role": "mechanic", "system": "sys.match_format" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "group_size", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 4.0, "max": 16.0 }, "required": true },
            { "key": "advance_count", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 1.0, "max": 8.0 }, "required": true },
            { "key": "participant_table_id", "kind": { "kind": "text" }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "{param:participant_table_id}", "property": "advancement_state", "formula": "group_points += points(win_or_draw)" },
            { "effect": "roll_check", "formula": "group_rank <= {param:advance_count} at group_end", "difficulty_expr": "0", "on_success": [
              { "effect": "change_state", "machine": "match_participant.bracket_state", "to_state": "advanced" }
            ], "on_failure": [
              { "effect": "change_state", "machine": "match_participant.bracket_state", "to_state": "eliminated" }
            ] }
          ]
        }
      ]
    },
