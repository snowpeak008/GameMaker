{
  "pack_id": "grid_strategy",
  "pack_version": "0.1.0",
  "display_name": "战棋·网格战术（示例数值：正式内容待逆向产线校准）",
  "reference_games": ["Fire Emblem", "Into the Breach", "Advance Wars", "Triangle Strategy"],
  "cardinality_expectations": {
    "unit_types": { "min": 6, "max": 30 },
    "class_types": { "min": 4, "max": 12 },
    "class_counter_cells": { "min": 16, "max": 144 },
    "terrain_types": { "min": 4, "max": 12 },
    "asset_specs": { "min": 8, "max": 42 },
    "stage_count": { "min": 8, "max": 40 },
    "progression_rows": { "min": 4, "max": 12 },
    "enemy_deploy_rows": { "min": 24, "max": 600 }
