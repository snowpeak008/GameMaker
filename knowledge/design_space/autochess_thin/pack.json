  "nodes": [
    { "id": "grid_battlefield", "domain_id": "gameplay_system_design", "name": "自走棋·棋盘与站位", "description": "棋盘网格结构与准备期站位（tactical_board MG 迁移承接点的归属位）。", "role_class": "system_concrete" },
    { "id": "grid_terrain", "domain_id": "gameplay_system_design", "name": "自走棋·棋盘地形（迁移承接位）", "description": "tactical_board MG1 迁移承接点的归属位——自走棋均质棋盘不使用地形，本节点仅承接模块决策点的组织归属。", "role_class": "system_concrete" }
