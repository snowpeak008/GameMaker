        },
        {
          "id": "escalating_cost_gate",
          "label": "递增成本闸门",
          "summary": "同种守卫每多部署一个，其部署成本按增长率递增；移除时按比例返还资源",
          "implications": ["抑制单一守卫铺满防线，逼出混编阵容", "增长率与回复节奏共同决定防线成型速度"],
          "compiler_tags": { "spec_role": "mechanic", "system": "ld.deploy_system" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "cost_growth", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 1.0, "max": 3.0 }, "required": true },
            { "key": "refund_ratio", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 1.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "consume_resource", "resource": "energy", "formula": "cost(guard) * {param:cost_growth} ^ deployed_count(guard)" },
            { "effect": "spawn_entity", "entity": "ld.guard_roster" }
          ]
        }
      ]
    },
