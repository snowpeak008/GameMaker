    {
      "id": "ld.counter_damage",
      "node_id": "ld_combat",
      "domain": "combat",
      "level": "L4",
      "genre_scope": { "pack": "lane_defense" },
      "question": "克制伤害的机制规则是什么？",
      "options": [
        {
          "id": "multiplier_formula",
          "label": "克制系数乘法公式",
          "summary": "伤害 = 攻击力 × 克制系数（系数来自克制矩阵）",
          "implications": ["克制矩阵是数值平衡核心"],
          "compiler_tags": { "spec_role": "mechanic", "system": "ld.combat_system" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "base_multiplier", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 1.0, "max": 5.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "ld.enemy_roster", "property": "hp", "formula": "hp - attack * counter_coeff * {param:base_multiplier}" }
          ]
        },
        {
          "id": "additive_counter_formula",
          "label": "克制加值与保底公式",
          "summary": "伤害 = 攻击力 + 克制系数 × 加值权重，并设最低伤害保底",
          "implications": ["克制以加值而非倍率进入，低攻守卫同样吃得到克制收益", "保底值决定最慢击杀时间，防止高护甲敌人完全免疫"],
          "compiler_tags": { "spec_role": "mechanic", "system": "ld.combat_system" },
          "parameter_schema": { "schema": "scalar", "fields": [
            { "key": "counter_bonus_weight", "kind": { "kind": "float" }, "constraint": { "constraint": "range", "min": 0.0, "max": 100.0 }, "required": true },
            { "key": "min_damage", "kind": { "kind": "int" }, "constraint": { "constraint": "range", "min": 0.0, "max": 100.0 }, "required": true }
          ] },
          "effects_template": [
            { "effect": "modify_property", "entity": "ld.enemy_roster", "property": "hp", "formula": "hp - max(attack + counter_coeff * {param:counter_bonus_weight}, {param:min_damage})" }
          ]
        }
      ]
    },
