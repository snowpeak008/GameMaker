  },
  "intent": {
    "title": "霜落峡谷防卫计划",
    "experience_promise": "以小博大的守护：守护脆弱目标的压力曲线契合品类体验",
    "genre_structure": "通道塔防",
    "profile": {
      "u.business_model": "买断制",
      "u.platform": "PC 单机"
    }
  },
  "systems": [
    {
      "id": "ld.combat_system",
      "name": "克制式战斗",
      "purpose": "守卫与敌人之间存在克制关系，伤害受克制系数放大",
      "interfaces": [
        "需要克制矩阵",
        "需要伤害公式"
      ]
    },
    {
      "id": "ld.deploy_system",
      "name": "网格部署",
      "purpose": "守卫放置在固定网格位上，消耗资源",
      "interfaces": [
        "需要网格坐标",
        "需要部署成本规则"
      ]
    },
    {
      "id": "ld.economy_system",
      "name": "周期回复资源",
      "purpose": "资源随时间周期性增长，用于部署",
      "interfaces": [
        "需要回复节奏参数"
      ]
    },
    {
      "id": "ld.wave_system",
      "name": "脚本化波次",
      "purpose": "每关波次表预先设计，敌人按表出场",
      "interfaces": [
        "需要波次表",
        "需要敌人名单"
      ]
    }
  ],
  "mechanics": [
    {
      "id": "ld.counter_damage",
      "system_id": "ld.combat_system",
      "rule_text": "克制系数乘法公式。伤害 = 攻击力 × 克制系数（系数来自克制矩阵）（base_multiplier=2）",
      "preconditions": [],
      "effects": [
        {
          "effect": "modify_property",
          "entity": "ld.enemy_roster",
          "property": "hp",
          "formula": "hp - attack * counter_coeff * 2"
        }
      ],
      "state_machine": null
    },
    {
      "id": "ld.deploy_cost",
      "system_id": "ld.deploy_system",
      "rule_text": "成本闸门。部署消耗守卫成本，资源不足禁止部署；移除返还比例资源（refund_ratio=0.8）",
      "preconditions": [],
      "effects": [
        {
          "effect": "consume_resource",
          "resource": "energy",
          "formula": "cost(guard)"
        },
        {
          "effect": "spawn_entity",
          "entity": "ld.guard_roster"
        }
      ],
      "state_machine": null
    },
    {
      "id": "ld.income_rule",
      "system_id": "ld.economy_system",
      "rule_text": "周期定额回复。每隔固定秒数回复固定数额资源（amount=25, interval_seconds=5）",
      "preconditions": [],
      "effects": [
        {
          "effect": "grant_resource",
          "resource": "energy",
          "formula": "+25 / 5s"
        }
      ],
      "state_machine": null
    }
  ],
