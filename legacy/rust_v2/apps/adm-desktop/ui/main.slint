                    Button { x: 484px; y: 44px; width: 74px; height: 26px; text: "调用"; clicked => { root.invoke-ai-provider(); } }

                    Text { x: 10px; y: 78px; width: 84px; height: 20px; text: "步骤范围"; font-size: 12px; color: #57606a; }
