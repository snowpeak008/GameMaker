                            text: root.game-build-text + "\n\n" + root.sdk-bundle-text + "\n\n" + root.unity-build-text + "\n\n" + root.runtime-validation-text;
                            font-size: 11px;
                            color: #24292f;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // 运行日志
        Rectangle {
            visible: root.active-view == "logs";
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: parent.height - 24px;
            background: #ffffff;
            border-color: #d0d7de;
            border-width: 1px;
            border-radius: 6px;

            Text { x: 16px; y: 14px; text: "运行日志"; font-size: 18px; font-weight: 700; color: #1f2328; }
            LineEdit { x: 104px; y: 12px; width: 170px; height: 30px; text <=> root.run-log-filter; placeholder-text: "级别/范围/关键字"; }
            Button { x: 282px; y: 12px; width: 76px; height: 30px; text: "刷新"; clicked => { root.refresh-run-log(root.run-log-filter); } }
            Button { x: 366px; y: 12px; width: 76px; height: 30px; text: "清空"; clicked => { root.clear-run-log(); } }
            Button { x: 450px; y: 12px; width: 76px; height: 30px; text: "导出"; clicked => { root.export-run-log(); } }
            Button { x: 534px; y: 12px; width: 96px; height: 30px; text: "AI诊断"; clicked => { root.refresh-ai-diagnostics(); } }

            Rectangle {
                x: 16px;
                y: 58px;
                width: parent.width - 32px;
                height: parent.height - 74px;
                background: #0d1117;
                border-color: #30363d;
                border-width: 1px;
                border-radius: 6px;
                ScrollView {
                    x: 14px;
                    y: 12px;
                    width: parent.width - 28px;
                    height: parent.height - 24px;
                    viewport-width: parent.width - 28px;
                    viewport-height: 5200px;
                    Text {
                        width: parent.width;
                        height: 5200px;
                        text: root.run-log-text + "\n\n当前状态\n" + root.status-text + "\n\n" + root.pipeline-text + "\n\n" + root.ai-text + "\n\n" + root.validation-text + "\n\n" + root.engine-history-text;
                        font-size: 12px;
                        color: #c9d1d9;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // SDK 知识库
        Rectangle {
            visible: root.active-view == "sdk";
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            height: parent.height - 24px;
            background: #ffffff;
            border-color: #d0d7de;
            border-width: 1px;
            border-radius: 6px;

            Text { x: 16px; y: 14px; text: "SDK知识库"; font-size: 18px; font-weight: 700; color: #1f2328; }
            Button { x: 120px; y: 12px; width: 76px; height: 30px; text: "刷新"; clicked => { root.refresh-sdk-knowledge(); } }
            LineEdit { x: 204px; y: 12px; width: 150px; height: 30px; text <=> root.sdk-new-name; placeholder-text: "SDK 名称"; }
            LineEdit { x: 362px; y: 12px; width: 230px; height: 30px; text <=> root.sdk-new-url; placeholder-text: "SDK URL"; }
            Button { x: 600px; y: 12px; width: 84px; height: 30px; text: "新增 SDK"; clicked => { root.add-sdk-resource(root.sdk-new-name, root.sdk-new-url); } }
            LineEdit { x: 692px; y: 12px; width: 170px; height: 30px; text <=> root.sdk-review-selected-id; placeholder-text: "审批 ID"; }
            Button { x: 870px; y: 12px; width: 84px; height: 30px; text: "批准入库"; clicked => { root.approve-sdk-resource(root.sdk-review-selected-id); } }
            Button { x: 962px; y: 12px; width: 96px; height: 30px; text: "标记待审"; clicked => { root.mark-sdk-resource-pending(root.sdk-review-selected-id); } }
            Button { x: 1066px; y: 12px; width: 70px; height: 30px; text: "拒绝"; clicked => { root.reject-sdk-resource(root.sdk-review-selected-id); } }
            Button { x: 1144px; y: 12px; width: 90px; height: 30px; text: "暂存套件"; clicked => { root.stage-sdk-bundle(); } }

            Rectangle { x: 16px; y: 58px; width: parent.width - 32px; height: 84px; background: #f6f8fa; border-color: #d8dee4; border-width: 1px; border-radius: 6px;
                ScrollView {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: 64px;
                    viewport-width: parent.width - 24px;
                    viewport-height: 800px;
                    Text {
                        width: parent.width;
                        height: 800px;
                        text: root.sdk-review-text + "\n" + root.sdk-text;
                        font-size: 12px;
                        color: #24292f;
                        wrap: word-wrap;
                    }
                }
            }
            Rectangle { x: 16px; y: 154px; width: parent.width / 2 - 24px; height: parent.height - 170px; background: #ffffff; border-color: #d8dee4; border-width: 1px; border-radius: 6px;
                Text { x: 12px; y: 10px; text: "审批队列"; font-size: 13px; font-weight: 700; color: #1f2328; }
                ScrollView {
                    x: 12px;
                    y: 38px;
                    width: parent.width - 24px;
                    height: parent.height - 50px;
                    viewport-width: parent.width - 24px;
                    viewport-height: 2200px;
                    VerticalBox { width: parent.width; spacing: 6px;
                        for review in root.sdk-review-items: Rectangle {
                            height: 86px;
                            background: #f6f8fa;
                            border-color: #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            Text { x: 10px; y: 8px; width: parent.width - 20px; height: 18px; text: review.sdk_name + "  " + review.status; font-size: 12px; font-weight: 700; color: #1f2328; }
                            Text { x: 10px; y: 30px; width: parent.width - 20px; height: 16px; text: review.id + " | " + review.url; font-size: 11px; color: #57606a; }
                            Text { x: 10px; y: 50px; width: parent.width - 20px; height: 16px; text: review.target_engines + " | " + review.target_platforms + " | " + review.category; font-size: 11px; color: #57606a; }
                            Text { x: 10px; y: 68px; width: parent.width - 20px; height: 14px; text: review.note; font-size: 11px; color: #24292f; }
                        }
                    }
                }
            }
            Rectangle { x: parent.width / 2 + 8px; y: 154px; width: parent.width / 2 - 24px; height: parent.height - 170px; background: #ffffff; border-color: #d8dee4; border-width: 1px; border-radius: 6px;
                Text { x: 12px; y: 10px; text: "已索引资源"; font-size: 13px; font-weight: 700; color: #1f2328; }
                ScrollView {
                    x: 12px;
                    y: 38px;
                    width: parent.width - 24px;
                    height: parent.height - 50px;
                    viewport-width: parent.width - 24px;
                    viewport-height: 2200px;
                    VerticalBox { width: parent.width; spacing: 6px;
                        for resource in root.sdk-resource-items: Rectangle {
                            height: 78px;
                            background: #f6f8fa;
                            border-color: #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            Text { x: 10px; y: 8px; width: parent.width - 20px; height: 18px; text: resource.sdk_name + "  " + resource.category; font-size: 12px; font-weight: 700; color: #1f2328; }
                            Text { x: 10px; y: 30px; width: parent.width - 20px; height: 16px; text: resource.target_engines + " | " + resource.target_platforms + " | " + resource.required_for_build; font-size: 11px; color: #57606a; }
                            Text { x: 10px; y: 50px; width: parent.width - 20px; height: 18px; text: resource.purpose; font-size: 11px; color: #24292f; }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: root.height - 30px;
        width: root.width;
        height: 30px;
        background: #ffffff;
        border-color: #d0d7de;
        border-width: 1px;
        Text { x: 16px; y: 6px; width: root.width / 3; height: 18px; text: root.ai-config-summary; font-size: 11px; color: #57606a; }
        Text { x: root.width / 3; y: 6px; width: root.width / 3; height: 18px; text: root.stage-progress-text; font-size: 11px; color: #57606a; horizontal-alignment: center; }
        Text { x: root.width * 2 / 3; y: 6px; width: root.width / 3 - 16px; height: 18px; text: root.workspace-doctor-text; font-size: 11px; color: #57606a; horizontal-alignment: right; }
    }
}
