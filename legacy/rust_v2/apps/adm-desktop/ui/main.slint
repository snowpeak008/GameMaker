                    Button { height: 28px; text: "执行阶段  Step11 程序执行"; clicked => { root.inspect-stage("step11"); } }
                    Button { height: 28px; text: "执行阶段  Step12 美术生产"; clicked => { root.inspect-stage("step12"); } }
                    Button { height: 28px; text: "执行阶段  Step13 场景组装"; clicked => { root.inspect-stage("step13"); } }
                    Button { height: 28px; text: "执行阶段  Step14 集成验证"; clicked => { root.inspect-stage("step14"); } }
                }
