                    Button { x: 328px; y: 74px; width: 76px; height: 26px; text: "停止"; clicked => { root.stop-pipeline-run(); } }
                    Button { x: 412px; y: 74px; width: 96px; height: 26px; text: "恢复失败项"; clicked => { root.resume-failed-project(); } }

