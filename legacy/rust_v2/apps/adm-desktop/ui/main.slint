                Button { x: 90px; y: 10px; width: 76px; height: 28px; text: "缺失项"; clicked => { root.design-right-tab = "missing"; } }
                Button { x: 170px; y: 10px; width: 76px; height: 28px; text: "风险"; clicked => { root.design-right-tab = "risk"; } }
                Button { x: 250px; y: 10px; width: 76px; height: 28px; text: "校验"; clicked => { root.design-right-tab = "validation"; } }

