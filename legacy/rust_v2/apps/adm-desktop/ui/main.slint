import { Button, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

export struct StageRow {
    id: string,
    label: string,
    status: string,
    artifacts: string,
    message: string,
}

export struct StageArtifactRow {
    path: string,
}

export struct ProjectRow {
    archive_id: string,
    display_name: string,
    locked: string,
}

export struct CoreArtifactRow {
    area: string,
    count: string,
    summary: string,
}

export struct AiProviderRow {
    provider_id: string,
    readiness: string,
    capabilities: string,
    notes: string,
}

export struct AiTaskRow {
    capability: string,
    status: string,
    provider: string,
    failure: string,
    summary: string,
}

export struct PackageFileRow {
    kind: string,
    path: string,
}

export struct BuildTargetRow {
    target_id: string,
    engine: string,
    platform: string,
    profile: string,
    output_file: string,
    required_artifacts: string,
}

export struct EngineHistoryRow {
    target_id: string,
    mode: string,
    status: string,
    launched: string,
    exit_code: string,
    expected_output: string,
    expected_output_path: string,
    expected_output_present: string,
    expected_output_bytes: string,
    expected_output_hash: string,
}

export struct DeliveryCheckRow {
    scope: string,
    path: string,
    present: string,
}

export struct SdkResourceRow {
    sdk_name: string,
    category: string,
    target_engines: string,
    target_platforms: string,
    required_for_build: string,
    purpose: string,
    ai_explanation: string,
    risks: string,
    validation: string,
}

export struct SdkReviewRow {
    id: string,
    sdk_name: string,
    url: string,
    status: string,
    category: string,
    target_engines: string,
    target_platforms: string,
    purpose: string,
    note: string,
}

export struct ValidationIssueRow {
    status: string,
    code: string,
    message: string,
}

export struct AcceptanceTraceRow {
    trace_id: string,
    scenario_id: string,
    source_mechanic: string,
    development_task_id: string,
    asset_task_id: string,
    sdk_resources: string,
    build_targets: string,
    validation_probe: string,
    status: string,
}

export struct DomainRow {
    id: string,
    name: string,
    summary: string,
    progress: string,
    active: bool,
}

export struct DesignNodeRow {
    id: string,
    name: string,
    role: string,
    status: string,
    detail: string,
    active: bool,
}

export struct OptionGroupRow {
    node: string,
    label: string,
    mode: string,
    question: string,
}

export struct ChecklistRow {
    node_id: string,
    item_id: string,
    label: string,
    description: string,
    checked: bool,
    progress: string,
}

export struct L4OptionRow {
    node_id: string,
    item_id: string,
    group_id: string,
    option_id: string,
    item_label: string,
    group_label: string,
    option_label: string,
    description: string,
    mode: string,
    question: string,
    required: bool,
    allow_primary: bool,
    selected: bool,
    is_primary: bool,
}

export struct TemplateRow {
    id: string,
    name: string,
    source: string,
    target_scale: string,
    quality: string,
    summary: string,
}

export component MainWindow inherits Window {
    title: "自动设计生成器（桌面版）";
    width: 1280px;
    height: 860px;

    in-out property <string> active-view: "design";
    in-out property <string> design-right-tab: "summary";
    in-out property <string> design-export-format: "markdown";

    in-out property <string> project-title: "新游戏";
    in-out property <string> project-genre: "2D 动作冒险";
    in-out property <string> project-promise: "快速探索、精准战斗、清晰反馈";
    in-out property <string> project-core-loop: "探索空间 | 解决战斗或移动挑战 | 获得反馈和下一个目标";
    in-out property <string> data-root: "";
    in-out property <string> selected-archive-id: "";
    in-out property <string> export-path: "";
    in-out property <string> import-path: "";
    in-out property <string> release-source-exe: "";
    in-out property <string> release-target-dir: "";
    in-out property <string> game-build-target-id: "windows_desktop_playable";
    in-out property <string> game-build-target-dir: "";
    in-out property <string> sdk-bundle-target-dir: "";
    in-out property <string> unity-exe: "C:\\Program Files\\Unity\\Editor\\Unity.exe";
    in-out property <string> unity-project-dir: "";
    in-out property <string> runtime-results-file: "";
    in-out property <string> unity-confirm-token: "";
    in-out property <string> ai-provider-preset: "openai";
    in-out property <string> ai-provider-id: "openai";
    in-out property <string> ai-provider-endpoint: "https://api.openai.com/v1";
    in-out property <string> ai-provider-secret-ref: "env:OPENAI_API_KEY";
    in-out property <string> ai-provider-secret-value: "";
    in-out property <string> ai-provider-capabilities: "text_generation";
    in-out property <string> ai-provider-model: "gpt-test";
    in-out property <string> ai-provider-prompt: "请从 AutoDesignMaker 返回问候。";
    in-out property <string> status-text: "就绪";
    in-out property <string> pipeline-text: "流水线空闲。";
    in-out property <string> ai-text: "智能服务空闲。";
    in-out property <string> ai-config-text: "智能服务诊断尚未加载。";
    in-out property <string> ai-config-summary: "智能服务诊断尚未加载。";
    in-out property <string> package-text: "尚未检查项目包。";
    in-out property <string> build-target-text: "尚未检查构建目标。";
    in-out property <string> engine-history-text: "尚未检查引擎历史。";
    in-out property <string> sdk-text: "尚未检查开发套件。";
    in-out property <string> release-text: "尚未暂存桌面发布包。";
    in-out property <string> release-doctor-text: "尚未运行发布诊断。";
    in-out property <string> delivery-doctor-text: "尚未运行交付诊断。";
    in-out property <string> game-build-text: "尚未暂存游戏构建包。";
    in-out property <string> sdk-bundle-text: "尚未暂存开发套件包。";
    in-out property <string> unity-build-text: "尚未规划 Unity 构建命令。";
    in-out property <string> runtime-validation-text: "尚未规划运行时验证。";
    in-out property <string> core-artifact-text: "尚未检查核心产物。";
    in-out property <string> validation-text: "尚未检查验证结果。";
    in-out property <string> acceptance-trace-text: "尚未检查验收矩阵。";
    in-out property <string> stage-progress-text: "阶段：尚未运行。";
    in-out property <string> stage-detail-text: "尚未选择阶段详情。";
    in-out property <string> stage-detail-label: "未选择阶段";
    in-out property <string> stage-detail-id: "";
    in-out property <string> stage-detail-status: "";
    in-out property <string> stage-detail-message: "";
    in-out property <string> pipeline-range-start: "0";
    in-out property <string> pipeline-range-end: "14";
    in-out property <string> pipeline-style-choice: "style_readable_2d";
    in-out property <string> pipeline-style-prompt: "清晰轮廓、高对比反馈、适合快速验证的 2D 风格";
    in-out property <string> pipeline-service-text: "流水线服务尚未记录请求。";
    in-out property <string> run-log-filter: "";
    in-out property <string> run-log-text: "严格运行日志尚未加载。";
    in-out property <string> run-log-export-path: "";
    in-out property <[StageRow]> stage-items;
    in-out property <[StageArtifactRow]> stage-artifact-items;
    in-out property <[ProjectRow]> project-items;
    in-out property <[CoreArtifactRow]> core-artifact-items;
    in-out property <[AiProviderRow]> ai-provider-items;
    in-out property <[AiTaskRow]> ai-task-items;
    in-out property <[PackageFileRow]> package-file-items;
    in-out property <[BuildTargetRow]> build-target-items;
    in-out property <[EngineHistoryRow]> engine-history-items;
    in-out property <[DeliveryCheckRow]> delivery-check-items;
    in-out property <[SdkResourceRow]> sdk-resource-items;
    in-out property <[SdkReviewRow]> sdk-review-items;
    in-out property <[ValidationIssueRow]> validation-issue-items;
    in-out property <[AcceptanceTraceRow]> acceptance-trace-items;
    in-out property <string> project-list: "尚未加载项目。";
    in-out property <string> project-detail: "尚未选择项目。";
    in-out property <string> package-doctor-text: "尚未检查项目包。";
    in-out property <string> workspace-doctor-text: "尚未检查工作区。";
    in-out property <string> supplement-request-text: "";
    in-out property <string> supplement-analysis-text: "尚未分析补充开发需求。";
    in-out property <string> sdk-new-name: "";
    in-out property <string> sdk-new-url: "";
    in-out property <string> sdk-review-selected-id: "";
    in-out property <string> sdk-review-text: "SDK 审批队列尚未加载。";

    in-out property <[DomainRow]> domain-items;
    in-out property <[DesignNodeRow]> design-node-items;
    in-out property <[OptionGroupRow]> option-group-items;
    in-out property <[ChecklistRow]> checklist-items;
    in-out property <[L4OptionRow]> l4-option-items;
    in-out property <[TemplateRow]> template-items;
    in-out property <string> selected-template-id: "";
    in-out property <string> design-template-text: "模板尚未加载。";
    in-out property <string> selected-design-node-id: "";
    in-out property <string> selected-design-node-title: "未选择节点";
    in-out property <string> selected-design-node-status: "";
    in-out property <string> selected-design-node-detail: "请先选择一个设计节点。";
    in-out property <string> design-node-design-note: "";
    in-out property <string> design-node-risk-note: "";
    in-out property <string> design-node-na-reason: "";
    in-out property <string> design-l5-json: "[]";
    in-out property <string> design-l5-errors-text: "未选择节点。";
    in-out property <string> design-l5-enabled-text: "当前节点不需要 L5 实体。";
    in-out property <string> design-profile-text: "项目画像尚未加载。";
    in-out property <string> design-summary-text: "摘要尚未加载。";
    in-out property <string> design-missing-text: "缺失项尚未加载。";
    in-out property <string> design-risk-text: "风险尚未加载。";
    in-out property <string> design-validation-text: "校验尚未加载。";
    in-out property <string> design-ai-interview-text: "AI 访谈尚未加载。";
    in-out property <string> design-interview-input: "";

    callback create-and-run();
    callback refresh-projects();
    callback inspect-workspaces();
    callback cleanup-workspaces();
    callback refresh-ai-diagnostics();
    callback refresh-design-reference();
    callback select-design-domain(string);
    callback select-design-node(string);
    callback save-design-project-name(string);
    callback export-design-workbench(string);
    callback save-design-archive();
    callback load-design-archive(string);
    callback refresh-design-templates();
    callback load-design-template(string);
    callback save-design-template(string);
    callback set-design-checklist(string, string, bool);
    callback set-design-l4-option(string, string, string, string, bool);
    callback set-design-primary-option(string, string, string, string);
    callback save-design-node-text(string, string, string, string);
    callback save-design-l5-json(string, string);
    callback clear-design-l5-json(string);
    callback start-design-ai-interview(string);
    callback record-design-ai-response(string);
    callback run-design-ai-interview(string, string, string);
    callback reset-design-workbench();
    callback analyze-supplement(string);
    callback apply-ai-provider-preset();
    callback save-ai-provider();
    callback save-ai-secret();
    callback check-ai-provider();
    callback invoke-ai-provider();
    callback disable-ai-provider();
    callback export-project();
    callback check-import-package();
    callback import-project();
    callback stage-desktop-release();
    callback release-doctor();
    callback delivery-doctor();
    callback stage-game-build-bundle();
    callback stage-sdk-bundle();
    callback stage-unity-project();
    callback plan-unity-build();
    callback unity-build-preflight();
    callback dry-run-unity-build();
    callback run-unity-build();
    callback plan-unity-runtime-validation();
    callback dry-run-unity-runtime-validation();
    callback run-unity-runtime-validation();
    callback record-runtime-validation();
    callback select-project();
    callback resume-project();
    callback inspect-stage(string);
    callback rerun-stage(string);
    callback resume-failed-project();
    callback release-current-lock();
    callback clear-external-lock();
    callback run-pipeline-range(string, string);
    callback stop-pipeline-run();
    callback confirm-pipeline-style(string, string);
    callback refresh-run-log(string);
    callback clear-run-log();
    callback export-run-log();
    callback refresh-sdk-knowledge();
    callback add-sdk-resource(string, string);
    callback approve-sdk-resource(string);
    callback mark-sdk-resource-pending(string);
    callback reject-sdk-resource(string);

    background: #f3f5f7;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 58px;
        background: #ffffff;
        border-color: #d0d7de;
        border-width: 1px;

        Text {
            x: 16px;
            y: 12px;
            width: 170px;
            text: "AutoDesignMaker";
            font-size: 20px;
            font-weight: 700;
            color: #1f2328;
        }

        Button { x: 196px; y: 10px; width: 96px; height: 36px; text: "设计工作台"; clicked => { root.active-view = "design"; } }
        Button { x: 300px; y: 10px; width: 96px; height: 36px; text: "开发流水线"; clicked => { root.active-view = "pipeline"; } }
        Button { x: 404px; y: 10px; width: 96px; height: 36px; text: "补充开发"; clicked => { root.active-view = "patch"; } }
        Button { x: 508px; y: 10px; width: 96px; height: 36px; text: "打包阶段"; clicked => { root.active-view = "package"; } }
        Button { x: 612px; y: 10px; width: 96px; height: 36px; text: "运行日志"; clicked => { root.active-view = "logs"; } }
        Button { x: 716px; y: 10px; width: 104px; height: 36px; text: "SDK知识库"; clicked => { root.active-view = "sdk"; } }

        Text {
            x: root.width - 360px;
            y: 12px;
            width: 344px;
            height: 34px;
            text: root.status-text;
            color: #0969da;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 0px;
        y: 58px;
        width: root.width;
        height: root.height - 88px;
        background: #f3f5f7;

        // 设计工作台
        Rectangle {
            visible: root.active-view == "design";
            width: parent.width;
            height: parent.height;
            background: #f3f5f7;

            Rectangle {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: 52px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;

                Text { x: 12px; y: 10px; width: 68px; height: 28px; text: "项目名称"; font-size: 12px; color: #57606a; vertical-alignment: center; }
                LineEdit { x: 82px; y: 10px; width: 166px; height: 28px; text <=> root.project-title; }
                Button { x: 254px; y: 10px; width: 54px; height: 28px; text: "应用"; clicked => { root.save-design-project-name(root.project-title); } }
                Text { x: 318px; y: 10px; width: 68px; height: 28px; text: "导出格式"; font-size: 12px; color: #57606a; vertical-alignment: center; }
                LineEdit { x: 388px; y: 10px; width: 78px; height: 28px; text <=> root.design-export-format; }
                Button { x: 474px; y: 10px; width: 58px; height: 28px; text: "导出"; clicked => { root.export-design-workbench(root.design-export-format); } }
                Button { x: 540px; y: 10px; width: 70px; height: 28px; text: "存档管理"; clicked => { root.refresh-projects(); } }
                Button { x: 618px; y: 10px; width: 70px; height: 28px; text: "保存存档"; clicked => { root.save-design-archive(); } }
                Button { x: 696px; y: 10px; width: 70px; height: 28px; text: "载入存档"; clicked => { root.load-design-archive(root.selected-archive-id); } }
                Button { x: 774px; y: 10px; width: 70px; height: 28px; text: "模板查看"; clicked => { root.refresh-design-templates(); } }
                LineEdit { x: 852px; y: 10px; width: 126px; height: 28px; text <=> root.selected-template-id; placeholder-text: "模板 ID"; }
                Button { x: 986px; y: 10px; width: 70px; height: 28px; text: "载入模板"; clicked => { root.load-design-template(root.selected-template-id); } }
                Button { x: 1064px; y: 10px; width: 78px; height: 28px; text: "另存模板"; clicked => { root.save-design-template(root.project-title); } }
                Button { x: 1150px; y: 10px; width: 54px; height: 28px; text: "重置"; clicked => { root.reset-design-workbench(); } }
                Text { x: 1212px; y: 10px; width: parent.width - 1224px; height: 28px; text: root.selected-archive-id; color: #57606a; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
            }

            Rectangle {
                x: 16px;
                y: 76px;
                width: 286px;
                height: parent.height - 88px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;

                Text { x: 12px; y: 10px; width: 120px; text: "领域总览"; font-size: 15px; font-weight: 700; color: #1f2328; }
                Button { x: 188px; y: 8px; width: 84px; height: 26px; text: "刷新"; clicked => { root.refresh-design-reference(); } }

                ScrollView {
                    x: 10px;
                    y: 42px;
                    width: parent.width - 20px;
                    height: 232px;
                    viewport-width: parent.width - 20px;
                    viewport-height: 520px;

                    VerticalBox {
                        width: parent.width - 20px;
                        spacing: 6px;
                        for domain in root.domain-items: Rectangle {
                            height: 62px;
                            background: domain.active ? #ddf4ff : #f6f8fa;
                            border-color: domain.active ? #54aeff : #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            Text { x: 10px; y: 8px; width: parent.width - 20px; height: 18px; text: domain.name; font-size: 12px; font-weight: 700; color: #1f2328; }
                            Text { x: 10px; y: 28px; width: parent.width - 20px; height: 16px; text: domain.progress; font-size: 11px; color: #57606a; }
                            Text { x: 10px; y: 44px; width: parent.width - 20px; height: 14px; text: domain.summary; font-size: 10px; color: #6e7781; }
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.select-design-domain(domain.id); }
                            }
                        }
                    }
                }

                Text { x: 12px; y: 288px; width: 120px; text: "项目画像"; font-size: 15px; font-weight: 700; color: #1f2328; }
                Rectangle {
                    x: 10px;
                    y: 316px;
                    width: parent.width - 20px;
                    height: 122px;
                    background: #ffffff;
                    border-color: #d8dee4;
                    border-width: 1px;
                    border-radius: 6px;
                    Text { x: 10px; y: 8px; width: parent.width - 20px; height: 18px; text: "类型：" + root.project-genre; font-size: 11px; color: #24292f; }
                    Text { x: 10px; y: 30px; width: parent.width - 20px; height: 18px; text: "承诺：" + root.project-promise; font-size: 11px; color: #24292f; }
                    Text { x: 10px; y: 52px; width: parent.width - 20px; height: 54px; text: root.design-profile-text; font-size: 11px; color: #57606a; wrap: word-wrap; }
                }

                Text { x: 12px; y: 454px; width: 140px; text: "L5 级别选项"; font-size: 15px; font-weight: 700; color: #1f2328; }
                Rectangle {
                    x: 10px;
                    y: 482px;
                    width: parent.width - 20px;
                    height: parent.height - 494px;
                    background: #f6f8fa;
                    border-color: #d8dee4;
                    border-width: 1px;
                    border-radius: 6px;
                    Text { x: 10px; y: 8px; width: parent.width - 20px; height: 18px; text: root.design-l5-enabled-text; font-size: 11px; color: #57606a; }
                    LineEdit { x: 10px; y: 34px; width: parent.width - 20px; height: 28px; text <=> root.design-l5-json; }
                    Button { x: 10px; y: 72px; width: 88px; height: 28px; text: "保存 L5"; clicked => { root.save-design-l5-json(root.selected-design-node-id, root.design-l5-json); } }
                    Button { x: 106px; y: 72px; width: 88px; height: 28px; text: "清空 L5"; clicked => { root.clear-design-l5-json(root.selected-design-node-id); } }
                    Text { x: 10px; y: 112px; width: parent.width - 20px; height: parent.height - 122px; text: root.design-l5-errors-text; font-size: 10px; color: #cf222e; }
                }
            }

            Rectangle {
                x: 314px;
                y: 76px;
                width: parent.width - 690px;
                height: parent.height - 88px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;

                Text { x: 12px; y: 10px; width: 180px; text: "选项内容与节点逻辑"; font-size: 15px; font-weight: 700; color: #1f2328; }
                Text { x: parent.width - 260px; y: 10px; width: 248px; height: 22px; text: root.selected-design-node-status; font-size: 12px; color: #0969da; horizontal-alignment: right; vertical-alignment: center; }

                ScrollView {
                    x: 10px;
                    y: 42px;
                    width: parent.width - 20px;
                    height: 138px;
                    viewport-width: parent.width - 20px;
                    viewport-height: 720px;

                    VerticalBox {
                        width: parent.width - 20px;
                        spacing: 6px;
                        for node in root.design-node-items: Rectangle {
                            height: 64px;
                            background: node.active ? #ddf4ff : #f6f8fa;
                            border-color: node.active ? #54aeff : #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            Text { x: 10px; y: 8px; width: parent.width - 20px; height: 18px; text: node.name; font-size: 12px; font-weight: 700; color: #1f2328; }
                            Text { x: 10px; y: 28px; width: 220px; height: 16px; text: node.role; font-size: 11px; color: #57606a; }
                            Text { x: 236px; y: 28px; width: 140px; height: 16px; text: node.status; font-size: 11px; color: #0969da; }
                            Text { x: 10px; y: 46px; width: parent.width - 20px; height: 14px; text: node.detail; font-size: 10px; color: #57606a; }
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { root.select-design-node(node.id); }
