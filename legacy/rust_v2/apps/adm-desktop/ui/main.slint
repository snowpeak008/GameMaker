                    Button { height: 28px; text: "设计阶段  Step01 玩法框架"; clicked => { root.inspect-stage("step01"); } }
                    Button { height: 28px; text: "设计阶段  Step02 设计冻结"; clicked => { root.inspect-stage("step02"); } }
                    Button { height: 28px; text: "设计阶段  Step03 程序需求"; clicked => { root.inspect-stage("step03"); } }
                    Button { height: 28px; text: "设计阶段  Step04 美术需求"; clicked => { root.inspect-stage("step04"); } }
                    Button { height: 28px; text: "设计阶段  Step05 程序评审"; clicked => { root.inspect-stage("step05"); } }
                    Button { height: 28px; text: "设计阶段  Step06 美术评审"; clicked => { root.inspect-stage("step06"); } }
                    Button { height: 28px; text: "风格确认  Step07 美术风格"; clicked => { root.inspect-stage("step07"); } }
                    Button { height: 28px; text: "计划阶段  Step08 程序计划"; clicked => { root.inspect-stage("step08"); } }
                    Button { height: 28px; text: "计划阶段  Step09 美术计划"; clicked => { root.inspect-stage("step09"); } }
