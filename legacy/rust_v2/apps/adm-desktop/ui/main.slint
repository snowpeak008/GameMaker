                    Button { x: 284px; y: 8px; width: 66px; height: 26px; text: "选择"; clicked => { root.select-project(); } }
                    Button { x: 358px; y: 8px; width: 66px; height: 26px; text: "恢复"; clicked => { root.resume-project(); } }
                    Button { x: 432px; y: 8px; width: 96px; height: 26px; text: "导出到流水线"; clicked => { root.create-and-run(); } }

