                    LineEdit { x: parent.width / 3 + 2px; y: 58px; width: parent.width / 3 - 18px; height: 26px; text <=> root.design-node-risk-note; placeholder-text: "风险说明"; }
                    LineEdit { x: parent.width * 2 / 3 - 6px; y: 58px; width: parent.width / 3 - 92px; height: 26px; text <=> root.design-node-na-reason; placeholder-text: "不适用原因"; }
                    Button { x: parent.width - 82px; y: 58px; width: 72px; height: 26px; text: "保存"; clicked => { root.save-design-node-text(root.selected-design-node-id, root.design-node-design-note, root.design-node-risk-note, root.design-node-na-reason); } }
                }

