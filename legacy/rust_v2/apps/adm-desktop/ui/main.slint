                    LineEdit { x: 96px; y: 108px; width: 140px; height: 24px; text <=> root.pipeline-style-choice; }
                    LineEdit { x: 244px; y: 108px; width: parent.width - 376px; height: 24px; text <=> root.pipeline-style-prompt; }
                    Button { x: parent.width - 122px; y: 106px; width: 110px; height: 26px; text: "确认风格"; clicked => { root.confirm-pipeline-style(root.pipeline-style-choice, root.pipeline-style-prompt); } }
