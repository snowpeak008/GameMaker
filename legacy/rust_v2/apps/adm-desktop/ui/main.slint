                                Text { text: stage.status; width: 102px; font-size: 12px; color: #0969da; vertical-alignment: center; }
                                Text { text: stage.artifacts; width: 120px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                                Text { text: stage.message; font-size: 12px; color: #57606a; vertical-alignment: center; }
                                Button { text: "查看"; width: 58px; clicked => { root.inspect-stage(stage.id); } }
                                Button { text: "重跑"; width: 58px; clicked => { root.rerun-stage(stage.id); } }
                            }
                        }
                    }
                }

