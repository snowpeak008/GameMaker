                            Text { x: 10px; y: 26px; width: parent.width - 112px; height: 18px; text: item.description; font-size: 10px; color: #57606a; }
                            Text { x: parent.width - 96px; y: 6px; width: 36px; height: 18px; text: item.progress; font-size: 10px; color: #0969da; horizontal-alignment: right; }
                            Button { x: parent.width - 56px; y: 14px; width: 46px; height: 26px; text: item.checked ? "取消" : "勾选"; clicked => { root.set-design-checklist(item.node_id, item.item_id, !item.checked); } }
                        }
                    }
                }

                Text { x: 12px; y: 470px; width: 170px; text: "L4 选项组"; font-size: 15px; font-weight: 700; color: #1f2328; }
                ScrollView {
                    x: 10px;
                    y: 498px;
                    width: parent.width - 20px;
                    height: 116px;
                    viewport-width: parent.width - 20px;
                    viewport-height: 2400px;

                    VerticalBox {
                        width: parent.width - 20px;
                        spacing: 6px;
                        for option in root.l4-option-items: Rectangle {
                            height: 58px;
                            background: option.selected ? #ddf4ff : #ffffff;
                            border-color: option.selected ? #54aeff : #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            Text { x: 10px; y: 6px; width: parent.width - 150px; height: 16px; text: option.group_label + " / " + option.option_label; font-size: 11px; font-weight: 700; color: #1f2328; }
                            Text { x: 10px; y: 24px; width: parent.width - 150px; height: 14px; text: option.item_label + " | " + option.mode + (option.required ? " | 必填" : " | 可选"); font-size: 10px; color: #57606a; }
                            Text { x: 10px; y: 40px; width: parent.width - 150px; height: 14px; text: option.question; font-size: 10px; color: #57606a; }
                            Button { x: parent.width - 132px; y: 8px; width: 56px; height: 24px; text: option.selected ? "取消" : "选择"; clicked => { root.set-design-l4-option(option.node_id, option.item_id, option.group_id, option.option_id, !option.selected); } }
                            Button { x: parent.width - 70px; y: 8px; width: 60px; height: 24px; text: option.is_primary ? "主选" : "设主"; clicked => { root.set-design-primary-option(option.node_id, option.item_id, option.group_id, option.option_id); } }
                        }
                    }
                }

                Text { x: 12px; y: 628px; width: 150px; text: "AI 访谈设计"; font-size: 15px; font-weight: 700; color: #1f2328; }
                Rectangle {
