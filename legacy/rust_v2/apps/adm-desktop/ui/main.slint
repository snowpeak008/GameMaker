                ScrollView {
                    x: 10px;
                    y: 342px;
                    width: parent.width - 20px;
                    height: 116px;
                    viewport-width: parent.width - 20px;
                    viewport-height: 900px;

                    VerticalBox {
                        width: parent.width - 20px;
                        spacing: 6px;
                        for item in root.checklist-items: Rectangle {
                            height: 54px;
                            background: #ffffff;
                            border-color: #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
