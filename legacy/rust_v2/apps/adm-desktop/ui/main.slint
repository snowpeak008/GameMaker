                    y: 650px;
                    width: parent.width - 20px;
                    height: parent.height - 662px;
                    background: #f6f8fa;
                    border-color: #d8dee4;
                    border-width: 1px;
                    border-radius: 6px;
                    LineEdit { x: 12px; y: 10px; width: parent.width - 262px; height: 26px; text <=> root.design-interview-input; placeholder-text: "输入访谈关注点或用户回答"; }
                    Button { x: parent.width - 242px; y: 10px; width: 70px; height: 26px; text: "生成问题"; clicked => { root.start-design-ai-interview(root.design-interview-input); } }
                    Button { x: parent.width - 166px; y: 10px; width: 70px; height: 26px; text: "记录回答"; clicked => { root.record-design-ai-response(root.design-interview-input); } }
                    Button { x: parent.width - 90px; y: 10px; width: 78px; height: 26px; text: "调用AI"; clicked => { root.run-design-ai-interview(root.ai-provider-id, root.ai-provider-model, root.design-interview-input); } }
                    ScrollView {
