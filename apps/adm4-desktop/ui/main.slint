// adm4 桌面工作台：布局与交互沿用二版（顶部六视图导航 + 设计工作台三栏 + 底部状态栏），
// 语义（决策点/多选主选/人工豁免/自动保存/冻结门）按四版设计承载。
// 本文件只做呈现与手势转发，全部数据与可用性由 Rust 侧从后端聚合结果推出（D14）。

import { Button, ComboBox, GroupBox, LineEdit, ListView, ProgressIndicator, ScrollView, TextEdit } from "std-widgets.slint";

// —— 项目/存档 ——
export struct ProjectItem { id: string, name: string, updated: string, active: bool }

// —— 左栏：领域总览卡片（含 0 点领域）/ 项目画像 ——
export struct DomainCard { id: string, name: string, summary: string, progress: string, percent: int, active: bool, empty: bool }
export struct ProfileRow { label: string, value: string, hint: string }

// —— 中栏：节点列表 / 决策点检查单 / 选项 ——
export struct NodeCard { id: string, name: string, role: string, progress: string, detail: string, active: bool }
export struct CheckRow { id: string, question: string, meta: string, badge: string, badge-kind: string, active: bool }
export struct OptionRow { id: string, label: string, summary: string, selected: bool, is-primary: bool, focused: bool }

// —— 右栏四页签统一行模型：kind = header/ok/bad/info；target 非空则可点击跳转决策点 ——
export struct TextRow { title: string, text: string, kind: string, target: string }

// —— 访谈分层进度：一层一行 ——
export struct LevelRow { label: string, text: string, current: bool }

// —— G2 设计阶段风格门：风格网格的一张方向卡片 ——
// image 由 Rust 侧从落盘的预览图加载（slint::Image::load_from_path）；has-image=false 时
// 画「无图」占位框而不是画一张空图——那样看不出是「还没生成」还是「生成失败」。
// fit-kind = ok/caution/unknown（适配结论的配色），badge 是推荐标记文案。
export struct StyleCard {
    id: string,
    title: string,
    description: string,
    prompt-summary: string,
    prompt-origin: string,
    palette: string,
    fit: string,
    fit-kind: string,
    badge: string,
    failure: string,
    image: image,
    has-image: bool,
    selected: bool,
    active: bool,
}

// —— 流水线全版图：segment = C 段（实跑）/ P 段（Phase 2 占位）——
// duration/running/can-rerun/can-inspect 全部由 Rust 侧按后端运行状态推出，UI 只渲染。
export struct StageItem { id: string, name: string, status: string, summary: string, segment: string, duration: string, waiting: bool, running: bool, can-rerun: bool, can-inspect: bool, placeholder: bool }

export struct LogItem { at: string, category: string, message: string }

// —— 逆向模板维护面板 ——
export struct TemplateRow { id: string, game: string, status: string, depth: string, answers: string, active: bool }
export struct StepRow { name: string, reached: bool, current: bool }
export struct ConflictRow { decision: string, reason: string }
export struct CompareRow { decision: string, template-option: string, project-option: string, same: bool, params: string }

// T12 三视图行模型：SDK 审批队列 / 补充开发变更请求 / 文档集交付段。
export struct SdkRow { id: string, name: string, url: string, category: string, purpose: string, status: string, status-kind: string, signed: string, pending: bool }
export struct ChangeRow { id: string, title: string, requester: string, status: string, status-kind: string, segments: string, signed: string, next-token: string, next-label: string, can-impact: bool, can-advance: bool }
export struct DeliverRow { stage: string, present: bool, detail: string }

export component MainWindow inherits Window {
    title: "AutoDesignMaker V4 · 设计工作台";
    preferred-width: 1440px;
    preferred-height: 960px;
    min-width: 1180px;
    min-height: 760px;
    background: #f3f5f7;

    // ---------------- 视图与页签状态（纯 UI 状态）----------------
    in-out property <string> active-view: "design";
    in-out property <string> right-tab: "summary";
    in-out property <bool> archive-panel-open: false;
    in-out property <bool> template-panel-open: false;
    in-out property <bool> interview-open: true;
    // AI 配置面板是全局覆盖层（任何视图下都能开）：桌面用户配不了 AI，访谈/红队/C1-C5 全链走不通。
    in-out property <bool> ai-panel-open: false;

    // ---------------- 顶栏与状态栏 ----------------
    in property <string> project-title: "（未打开项目）";
    in property <string> project-pack: "";
    in property <string> autosave-text: "事务自动保存（V4 无手动保存按钮）";
    in property <string> status-message: "就绪";
    in property <string> completeness-text: "";
    in property <float> completeness-ratio: 0.0;

    // ---------------- 项目/存档 ----------------
    in property <[ProjectItem]> projects: [];
    in property <[string]> packs: [];

    // ---------------- 左栏 ----------------
    in property <[DomainCard]> domain-cards: [];
    in property <[ProfileRow]> profile-rows: [];
    in property <string> profile-title: "项目画像（L0/L1 已确认决策点聚合）";
    in property <string> level-brief: "尚未选择决策点。";

    // ---------------- 中栏 ----------------
    in property <[NodeCard]> node-cards: [];
    in property <[CheckRow]> check-rows: [];
    in property <string> center-title: "节点列表";
    in property <string> node-title: "（未选择节点）";
    in property <string> node-meta: "";
    in-out property <string> node-design-note: "";
    in-out property <string> node-risk-note: "";

    in property <[OptionRow]> options: [];
    in property <string> decision-title: "（未选择决策点）";
    in property <string> decision-meta: "";
    in property <string> decision-question: "";
    in property <bool> decision-active: false;
    in property <bool> decision-multi: false;
    in property <bool> decision-allow-primary: false;
    in property <bool> decision-primary-missing: false;
    in property <bool> decision-exempted: false;
    in property <string> decision-exemption-text: "";
    in property <string> focused-option-text: "";

    // 结构化表格/矩阵编辑器（后端 schema 驱动；JSON 文本框为高级模式）
    in property <bool> structured-active: false;
    in property <bool> advanced-mode: false;
    in property <string> editor-title: "";
    in property <[string]> table-columns: [];
    in property <[[string]]> table-rows-model: [];
    in-out property <string> param-json: "";

    // 访谈
    in property <[LevelRow]> interview-levels: [];
    in property <string> interview-progress-text: "";
    in property <string> interview-turn-kind: "";
    in property <string> interview-decision: "";
    in property <string> interview-option: "";
    in property <string> interview-rationale: "";
    in-out property <string> interview-params-json: "";
    in property <bool> interview-has-proposal: false;
    in property <bool> interview-params-editable: false;

    // ---------------- 右栏四页签 ----------------
    in property <[TextRow]> summary-rows: [];
    in property <[TextRow]> missing-rows: [];
    in property <[TextRow]> risk-rows: [];
    in property <[TextRow]> validation-rows: [];
    in property <bool> freeze-ready: false;
    in property <string> freeze-hint: "";

    // ---------------- 右栏「风格」页签（G2 设计阶段风格锚点门）----------------
    // 全部可用性由后端结果推出（D14）：style-can-generate 来自图像通道体检 + 项目是否打开，
    // style-ready 来自服务层的就绪查询，UI 不自己判断「能不能确认」。
    in property <[StyleCard]> style-cards: [];
    in property <string> style-summary: "尚未打开项目";
    in property <string> style-readiness: "";
    in property <bool> style-ready: false;
    in property <bool> style-can-generate: false;
    in property <string> style-gate-hint: "";
    in property <bool> style-running: false;
    in property <[TextRow]> style-lock-rows: [];
    /// 当前聚焦的方向 id（纯 UI 状态：单击卡片选中，双击看大图）。
    in-out property <string> style-selected: "";
    /// 改词编辑框：每次刷新由 Rust 侧填成该方向当前生效的**完整**提示词（不是摘要）。
    in-out property <string> style-prompt: "";
    in property <string> style-prompt-origin: "";
    // 大图覆盖层（册 08 §2.3「双击图片全屏放大」）。
    in-out property <bool> style-viewer-open: false;
    in property <image> style-viewer-image;
    in property <string> style-viewer-title: "";
    in property <string> style-viewer-prompt: "";
    in property <bool> style-viewer-has-image: false;

    // ---------------- 流水线 / 日志 ----------------
    in property <[StageItem]> stages: [];
    in property <string> pipeline-note: "";
    in property <[LogItem]> logs: [];

    // 范围运行 / 停止 / 重跑 / 阶段产物（F4c）
    in property <[string]> stage-ids: [];
    in-out property <string> pipeline-from: "C0";
    in-out property <string> pipeline-to: "C6";
    in property <bool> pipeline-running: false;
    in property <string> pipeline-run-hint: "";
    // 重跑二次确认：警示语由 Rust 侧按后端 downstream 列表生成，UI 只负责「先看再点」。
    in-out property <string> rerun-armed-stage: "";
    in property <string> rerun-warning: "";
    in property <[TextRow]> reset-rows: [];
    in property <string> artifact-stage: "";
    in property <string> artifact-title: "";
    in property <[TextRow]> artifact-rows: [];
    in property <string> artifact-doc: "";
    in property <string> artifact-hint: "";

    // ---------------- 图像通道配置（风格门要看真图）----------------
    in property <[string]> image-presets: [];
    in-out property <string> image-provider-id: "";
    in-out property <string> image-base-url: "";
    in-out property <string> image-model: "";
    in-out property <string> image-key-ref: "";
    in-out property <string> image-size: "";
    in-out property <string> image-timeout: "";
    in property <string> image-status: "图像通道：尚未诊断";
    in property <bool> image-available: false;

    // ---------------- AI Provider 配置与体检 ----------------
    in property <[string]> ai-presets: [];
    in-out property <string> ai-provider-id: "";
    in-out property <string> ai-base-url: "";
    in-out property <string> ai-model: "";
    in-out property <string> ai-key-ref: "";
    in-out property <string> ai-timeout: "";
    in property <string> ai-config-summary: "";
    in property <string> ai-status: "AI：尚未诊断";
    in property <bool> ai-available: false;
    in property <[TextRow]> ai-doctor-rows: [];
    // 实调用检查（真发一次请求，走网络）：后台线程期间置 true，按钮据此变灰。
    in property <bool> ai-invoke-running: false;
    in property <[TextRow]> ai-invoke-rows: [];
    // 密钥写入表单：名字进 app.json 的 named: 引用，值只进 config/secrets.json。
    in-out property <string> ai-secret-name: "";
    in-out property <string> ai-secret-value: "";
    in property <string> ai-secret-names: "";

    // ---------------- 另存模板 / 工作台重置 / 存档体检 ----------------
    in property <string> template-export-text: "";
    in-out property <bool> reset-armed: false;
    in property <string> reset-warning: "";
    in property <string> reset-result: "";
    in property <[TextRow]> doctor-rows: [];
    in property <string> doctor-summary: "尚未体检";

    // ---------------- 逆向模板维护 ----------------
    in property <[TemplateRow]> template-list: [];
    in property <[StepRow]> template-steps: [];
    in property <string> reverse-selected: "（未选择模板）";
    in property <[ConflictRow]> template-conflicts: [];
    in property <[CompareRow]> compare-rows: [];
    in property <string> compare-title: "";

    // ---------------- T12 三视图（补充开发 / 打包 / SDK 知识库）----------------
    in property <[SdkRow]> sdk-rows: [];
    in property <string> sdk-counts: "待审 0 · 已批准 0 · 已拒绝 0";
    in property <[ChangeRow]> change-rows: [];
    in property <string> change-summary: "尚未打开项目";
    in property <[DeliverRow]> deliver-rows: [];
    in property <string> deliver-summary: "尚未打开项目";

    // ---------------- 系统组合（W7：系统模块 / 档位 / 组合校验 / 署名形态确认）----------------
    // 全部数据由 Rust 侧从 AppServices 聚合（D14）：档位选择不在本面板落值——实例行
    // 点击即跳中栏该实例的 tier 合成点（普通 L3 单选点，走既有 select+confirm 通道）。
    in-out property <bool> system-panel-open: false;
    in property <string> system-summary: "";
    in property <[TextRow]> system-instance-rows: [];
    in property <[TextRow]> system-module-rows: [];
    in property <[TextRow]> system-report-rows: [];
    // |H| 超参考线的一次性署名形态确认：required 时出确认卡（署名必填由后端判，
    // 确认必须是用户点击——AI/自动流程永不触发 system-confirm-form）。
    in property <bool> system-confirm-required: false;
    in property <string> system-confirm-text: "";
    in property <string> system-confirmed-text: "";

    // ---------------- 回调 ----------------
    callback refresh-projects();
    callback create-project(string, string, string);
    callback open-project(string);
    callback refresh-workbench();

    callback select-domain(string);
    callback select-node(string);
    callback select-decision(string);
    callback save-node-notes(string, string);

    callback choose-option(string);
    callback toggle-option(string, bool);
    callback set-primary-option(string);
    callback focus-option(string);
    callback confirm-decision();
    callback set-not-applicable(string, string, string);
    callback clear-not-applicable();

    callback edit-table-cell(int, int, string);
    callback add-table-row();
    callback remove-table-row(int);
    callback save-table();
    callback set-advanced-mode(bool);
    callback save-params(string);

    callback interview-next();
    callback interview-confirm(string);
    callback interview-reject(string);

    callback run-red-team();
    callback freeze-check();
    callback freeze-run();
    callback export-workbench(string);

    callback pipeline-run-range(string, string);             // from, to
    callback pipeline-stop();
    callback pipeline-rerun-arm(string);                     // 取该段的下游清单并生成警示语（不执行）
    callback pipeline-rerun-confirm(string, string);         // stage, to（二次确认后才真跑）
    callback pipeline-artifact(string);                      // 查看该段产物（document.md / contract.json）
    callback pipeline-confirm(string, string);
    callback refresh-logs(string);
    callback export-logs(string);

    // AI Provider 配置与体检（V2 的 7 个 AI 回调在此收敛为 5 个）
    callback ai-refresh();
    callback ai-apply-preset(string);
    callback ai-save(string, string, string, string, string); // provider-id, base-url, model, key-ref, timeout
    callback ai-doctor();
    callback ai-invoke-check();
    callback ai-save-secret(string, string); // 密钥名, 密钥值（值只落 config/secrets.json）
    callback ai-disable();

    // 图像通道配置（config/app.json 的 image_provider 段）
    callback image-apply-preset(string);
    callback image-save(string, string, string, string, string, string); // id, url, model, key-ref, size, timeout
    callback image-disable();

    // G2 风格门：GUI 只转发（署名/结论必填、无图不许确认、未确认阻断下游都在服务层判）
    callback style-refresh();
    callback style-generate(bool);                    // force：true = 推翻重生成/重新选择
    callback style-select(string);                    // 单击卡片：聚焦方向
    callback style-open-viewer(string);               // 双击卡片：看大图
    callback style-regenerate(string, string);        // 方向 id, 新提示词
    callback style-clear-prompt(string);              // 回到锚定真源的派生提示词
    callback style-confirm(string, string, string);   // 方向 id, 署名, 结论

    // 系统组合：刷新（开面板/署名后重取）+ 署名形态确认（用户手势）。
    // 档位跳转不设新回调：面板行点击关面板后直接走既有 select-decision 通道。
    callback system-refresh();
    callback system-confirm-form(string, string); // 署名, 说明

    // 另存模板 / 工作台重置 / 存档体检
    callback template-export(string, string, string, string, string); // id, 模板名, 别名, 审核人, 审核结论
    callback workbench-reset-arm();
    callback workbench-reset(string, string);                          // 操作人, 理由
    callback project-doctor();

    callback reverse-select-pack(string);
    callback reverse-refresh();
    callback reverse-select-template(string);
    callback reverse-new-draft(string, string, string, string);
    callback reverse-search(string, string, string);
    callback reverse-map();
    callback reverse-crosscheck();
    callback reverse-review(string, string);
    callback reverse-certify();
    callback reverse-compare();
    callback template-prefill();

    // T12 三视图回调（GUI 无业务规则：一律转发给 AppServices，可用性由后端结果推出）。
    callback sdk-refresh();
    callback sdk-add(string, string, string, string);        // name, url, category, purpose
    callback sdk-approve(string, string, string);            // id, reviewer, note
    callback sdk-reject(string, string, string);             // id, reviewer, note
    callback change-refresh();
    callback change-add(string, string, string);             // title, requester, description
    callback change-impact(string, string);                  // id, segments-csv（C0..C6）
    callback change-advance(string, string, string, string); // id, target-token, actor, note
    callback deliver-refresh();
    callback deliver-package();
    callback project-export(string);                         // 导出路径
    callback project-import(string, string);                 // 导入路径, 项目名

    VerticalLayout {
        // =====================================================================
        // 顶栏：六视图导航（对照二版 main.slint 383-388 行）
        // =====================================================================
        Rectangle {
            height: 58px;
            background: #ffffff;
            border-color: #d0d7de;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                Text {
                    text: "AutoDesignMaker";
                    width: 168px;
                    font-size: 19px;
                    font-weight: 700;
                    color: #1f2328;
                    vertical-alignment: center;
                }
                Button {
                    text: "设计工作台";
                    width: 100px;
                    primary: root.active-view == "design";
                    clicked => { root.active-view = "design"; }
                }
                Button {
                    text: "开发流水线";
                    width: 100px;
                    primary: root.active-view == "pipeline";
                    clicked => { root.active-view = "pipeline"; }
                }
                Button {
                    text: "补充开发";
                    width: 92px;
                    primary: root.active-view == "patch";
                    clicked => { root.active-view = "patch"; }
                }
                Button {
                    text: "打包阶段";
                    width: 92px;
                    primary: root.active-view == "package";
                    clicked => { root.active-view = "package"; }
                }
                Button {
                    text: "运行日志";
                    width: 92px;
                    primary: root.active-view == "logs";
                    clicked => { root.active-view = "logs"; }
                }
                Button {
                    text: "SDK知识库";
                    width: 104px;
                    primary: root.active-view == "sdk";
                    clicked => { root.active-view = "sdk"; }
                }
                Button {
                    text: root.ai-panel-open ? "关闭AI配置" : "AI配置/诊断";
                    width: 108px;
                    clicked => {
                        root.ai-panel-open = !root.ai-panel-open;
                        if (root.ai-panel-open) { root.ai-refresh(); }
                    }
                }
                Text {
                    text: root.status-message;
                    horizontal-stretch: 1;
                    color: #0969da;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        // =====================================================================
        // 视图区
        // =====================================================================
        Rectangle {
            vertical-stretch: 1;
            background: #f3f5f7;

            // -----------------------------------------------------------------
            // 一、设计工作台（对照二版 410-707 行的三栏比例与交互模式）
            // -----------------------------------------------------------------
            if root.active-view == "design": VerticalLayout {
                // 条件元素在非布局父节点里不会自动拉满，必须显式贴合视图区。
                width: parent.width;
                height: parent.height;
                padding: 12px;
                spacing: 10px;

                // 顶部工具条
                Rectangle {
                    height: 52px;
                    background: #ffffff;
                    border-color: #d0d7de;
                    border-width: 1px;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            text: "项目";
                            width: 34px;
                            font-size: 12px;
                            color: #57606a;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.project-title;
                            width: 210px;
                            font-size: 13px;
                            font-weight: 700;
                            color: #1f2328;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.autosave-text;
                            width: 232px;
                            font-size: 11px;
                            color: #1a7f37;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Button {
                            text: root.archive-panel-open ? "关闭存档管理" : "存档管理";
                            width: 108px;
                            clicked => {
                                root.archive-panel-open = !root.archive-panel-open;
                                root.template-panel-open = false;
                                root.system-panel-open = false;
                                root.refresh-projects();
                            }
                        }
                        Button {
                            text: root.template-panel-open ? "关闭模板面板" : "模板/逆向维护";
                            width: 122px;
                            clicked => {
                                root.template-panel-open = !root.template-panel-open;
                                root.archive-panel-open = false;
                                root.system-panel-open = false;
                                root.reverse-refresh();
                            }
                        }
                        Button {
                            text: root.system-panel-open ? "关闭系统组合" : "系统组合";
                            width: 108px;
                            clicked => {
                                root.system-panel-open = !root.system-panel-open;
                                root.archive-panel-open = false;
                                root.template-panel-open = false;
                                if (root.system-panel-open) { root.system-refresh(); }
                            }
                        }
                        Button {
                            text: "刷新工作台";
                            width: 96px;
                            clicked => { root.refresh-workbench(); }
                        }
                        export-path := LineEdit {
                            placeholder-text: "导出路径，例如 D:\\snapshot.md";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "导出快照";
                            width: 88px;
                            clicked => { root.export-workbench(export-path.text); }
                        }
                    }
                }

                // 三栏：与二版一致用显式几何摆位（左 286 / 中自适应 / 右 348）。
                // 不用 HorizontalLayout：中栏内含固定宽子元素，会把自身最大宽度收窄，
                // 导致右栏被挤到窗口中部、右侧留白。
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    // ---------------- 左栏 ----------------
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 286px;
                        height: parent.height;
                        background: #ffffff;
                        border-color: #d0d7de;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: "领域总览（全部领域，含 0 点域）";
                                height: 22px;
                                font-size: 13px;
                                font-weight: 700;
                                color: #1f2328;
                            }
                            ListView {
                                vertical-stretch: 3;
                                for domain in root.domain-cards: Rectangle {
                                    height: 68px;
                                    background: domain.active ? #ddf4ff : #f6f8fa;
                                    border-color: domain.active ? #54aeff : #d8dee4;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    TouchArea { clicked => { root.select-domain(domain.id); } }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 2px;
                                        Text {
                                            text: domain.name;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: domain.empty ? #6e7781 : #1f2328;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: domain.progress;
                                            font-size: 11px;
                                            color: #0969da;
                                        }
                                        // 进度条：完成度百分比来自后端聚合，UI 不重算。
                                        Rectangle {
                                            height: 4px;
                                            background: #eaeef2;
                                            border-radius: 2px;
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width * domain.percent / 100;
                                                height: parent.height;
                                                background: domain.percent == 100 ? #1a7f37 : #54aeff;
                                                border-radius: 2px;
                                            }
                                        }
                                        Text {
                                            text: domain.summary;
                                            font-size: 10px;
                                            color: #6e7781;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.profile-title;
                                height: 22px;
                                font-size: 13px;
                                font-weight: 700;
                                color: #1f2328;
                                overflow: elide;
                            }
                            ListView {
                                vertical-stretch: 2;
                                for field in root.profile-rows: Rectangle {
                                    height: 50px;
                                    background: #ffffff;
                                    border-color: #d8dee4;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 5px;
                                        spacing: 1px;
                                        Text {
                                            text: field.label;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #24292f;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: field.value;
                                            font-size: 11px;
                                            color: #0969da;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: field.hint;
                                            font-size: 10px;
                                            color: #6e7781;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "L5/L6 编辑入口（表格编辑在中栏决策点详情内）";
                                height: 20px;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1f2328;
                                overflow: elide;
                            }
                            Rectangle {
                                height: 132px;
                                background: #f6f8fa;
                                border-color: #d8dee4;
                                border-width: 1px;
                                border-radius: 6px;
                                Text {
                                    x: 8px;
                                    y: 6px;
                                    width: parent.width - 16px;
                                    height: parent.height - 12px;
                                    text: root.level-brief;
                                    font-size: 11px;
                                    color: #57606a;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // ---------------- 中栏 ----------------
                    Rectangle {
                        x: 296px;
                        y: 0px;
                        width: parent.width - 654px;
                        height: parent.height;
                        background: #ffffff;
                        border-color: #d0d7de;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                height: 24px;
                                spacing: 8px;
                                Text {
                                    text: root.center-title;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #1f2328;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.completeness-text;
                                    font-size: 11px;
                                    color: #57606a;
                                    width: 260px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            // 节点列表
                            ListView {
                                vertical-stretch: 3;
                                for node in root.node-cards: Rectangle {
                                    height: 56px;
                                    background: node.active ? #ddf4ff : #f6f8fa;
                                    border-color: node.active ? #54aeff : #d8dee4;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    TouchArea { clicked => { root.select-node(node.id); } }
                                    VerticalLayout {
                                        padding: 5px;
                                        spacing: 1px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: node.name;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: #1f2328;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: node.progress;
                                                font-size: 11px;
                                                color: #0969da;
                                                width: 120px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                        Text {
                                            text: node.role;
                                            font-size: 10px;
                                            color: #57606a;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: node.detail;
                                            font-size: 10px;
                                            color: #6e7781;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }

                            // 节点详情：设计说明 / 风险说明
                            Rectangle {
                                height: 96px;
                                background: #f6f8fa;
                                border-color: #d8dee4;
                                border-width: 1px;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 18px;
                                        spacing: 8px;
                                        Text {
                                            text: root.node-title;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #1f2328;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.node-meta;
                                            font-size: 10px;
                                            color: #57606a;
                                            width: 300px;
                                            horizontal-alignment: right;
                                            overflow: elide;
                                        }
                                    }
                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 6px;
                                        design-note := LineEdit {
                                            placeholder-text: "节点设计说明";
                                            text <=> root.node-design-note;
                                            horizontal-stretch: 1;
                                        }
                                        risk-note := LineEdit {
                                            placeholder-text: "节点风险说明（进右栏「风险」页签）";
                                            text <=> root.node-risk-note;
                                            horizontal-stretch: 1;
                                        }
                                        Button {
                                            text: "保存节点文本";
                                            width: 104px;
                                            clicked => { root.save-node-notes(design-note.text, risk-note.text); }
                                        }
                                    }
                                    Text {
                                        text: "节点文本按节点保存；决策点级理由是选项的 rationale（层级不同，互不替代）。";
                                        font-size: 10px;
                                        color: #6e7781;
                                        overflow: elide;
                                    }
                                }
                            }

                            // 决策点检查单
                            Text {
                                text: "决策点检查单（= 二版三级检查单；勾选语义 = 已确认）";
                                height: 20px;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1f2328;
                                overflow: elide;
                            }
                            ListView {
                                vertical-stretch: 4;
                                for item in root.check-rows: Rectangle {
                                    height: 50px;
                                    background: item.active ? #ddf4ff : #ffffff;
                                    border-color: item.active ? #54aeff : #d8dee4;
                                    border-width: 1px;
                                    border-radius: 6px;
                                    TouchArea { clicked => { root.select-decision(item.id); } }
                                    HorizontalLayout {
                                        padding: 5px;
                                        padding-right: 14px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 1px;
                                            Text {
                                                text: item.question;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: #1f2328;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: item.meta;
                                                font-size: 10px;
                                                color: #57606a;
                                                overflow: elide;
                                            }
                                        }
                                        Text {
                                            text: item.badge;
                                            width: 72px;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            color: item.badge-kind == "done"
                                                ? #1a7f37
                                                : (item.badge-kind == "warn"
                                                    ? #bf8700
                                                    : (item.badge-kind == "off" ? #6e7781 : #cf222e));
                                        }
                                    }
                                }
                            }

                            // 决策点详情
                            Rectangle {
                                vertical-stretch: 6;
                                background: #f6f8fa;
                                border-color: #d8dee4;
                                border-width: 1px;
                                border-radius: 6px;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 5px;

                                    Text {
                                        text: root.decision-title;
                                        height: 18px;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #1f2328;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.decision-meta;
                                        height: 16px;
                                        font-size: 11px;
                                        color: #0969da;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.decision-question;
                                        height: 16px;
                                        font-size: 11px;
                                        color: #57606a;
                                        overflow: elide;
                                    }
                                    if root.decision-primary-missing: Text {
                                        text: "多选点缺主选：请在下方选项行点「设主」——否则完成度门 1 会拦截冻结。";
                                        height: 16px;
                                        font-size: 11px;
                                        color: #cf222e;
                                        overflow: elide;
                                    }
                                    if root.decision-exempted: Text {
                                        text: root.decision-exemption-text;
                                        height: 16px;
                                        font-size: 11px;
                                        color: #bf8700;
                                        overflow: elide;
                                    }

                                    // 选项列表：单选 = 选择按钮；多选 = 勾选 + 设主
                                    ListView {
                                        vertical-stretch: 2;
                                        for option in root.options: Rectangle {
                                            height: 52px;
                                            background: option.selected ? #dafbe1 : #ffffff;
                                            border-color: option.focused
                                                ? #54aeff
                                                : (option.selected ? #4ac26b : #d8dee4);
                                            border-width: option.focused ? 2px : 1px;
                                            border-radius: 6px;
                                            HorizontalLayout {
                                                padding: 5px;
                                                spacing: 6px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 1px;
                                                    Text {
                                                        text: (option.is-primary ? "★ " : (option.selected ? "● " : "○ ")) + option.label;
                                                        font-size: 12px;
                                                        color: #1f2328;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: option.summary;
                                                        font-size: 10px;
                                                        color: #57606a;
                                                        overflow: elide;
                                                    }
                                                }
                                                if !root.decision-multi: Button {
                                                    text: option.selected ? "已选" : "选择";
                                                    width: 66px;
                                                    enabled: !option.selected;
                                                    clicked => { root.choose-option(option.id); }
                                                }
                                                if root.decision-multi: Button {
                                                    text: option.selected ? "取消勾选" : "勾选";
                                                    width: 80px;
                                                    clicked => { root.toggle-option(option.id, !option.selected); }
                                                }
                                                if root.decision-multi && root.decision-allow-primary: Button {
                                                    text: option.is-primary ? "主选" : "设主";
                                                    width: 66px;
                                                    enabled: option.selected && !option.is-primary;
                                                    clicked => { root.set-primary-option(option.id); }
                                                }
                                                Button {
                                                    text: "编辑参数";
                                                    width: 78px;
                                                    enabled: option.selected && !option.focused;
                                                    clicked => { root.focus-option(option.id); }
                                                }
                                            }
                                        }
                                    }

                                    // 参数编辑：结构化表格 / 高级 JSON 双模式
                                    Text {
                                        text: root.focused-option-text;
                                        height: 16px;
                                        font-size: 11px;
                                        color: #57606a;
                                        overflow: elide;
                                    }
                                    if root.structured-active && !root.advanced-mode: VerticalLayout {
                                        vertical-stretch: 2;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            height: 30px;
                                            spacing: 6px;
                                            Text {
                                                text: root.editor-title;
                                                font-size: 11px;
                                                color: #57606a;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Button { text: "新增行"; width: 76px; clicked => { root.add-table-row(); } }
                                            Button { text: "保存表格"; width: 86px; primary: true; clicked => { root.save-table(); } }
                                            Button { text: "高级JSON"; width: 88px; clicked => { root.set-advanced-mode(true); } }
                                        }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                spacing: 2px;
                                                HorizontalLayout {
                                                    spacing: 2px;
                                                    for column in root.table-columns: Text {
                                                        text: column;
                                                        width: 112px;
                                                        font-size: 11px;
                                                        color: #57606a;
                                                        overflow: elide;
                                                    }
                                                    Rectangle { width: 44px; }
                                                }
                                                for row[row-index] in root.table-rows-model: HorizontalLayout {
                                                    spacing: 2px;
                                                    for cell[col-index] in row: LineEdit {
                                                        text: cell;
                                                        width: 112px;
                                                        font-size: 12px;
                                                        edited(text) => { root.edit-table-cell(row-index, col-index, text); }
                                                    }
                                                    Button {
                                                        text: "删";
                                                        width: 44px;
                                                        clicked => { root.remove-table-row(row-index); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if !root.structured-active || root.advanced-mode: VerticalLayout {
                                        vertical-stretch: 2;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            height: 28px;
                                            spacing: 6px;
                                            Text {
                                                text: "参数（JSON：标量/表/矩阵）";
                                                font-size: 11px;
                                                color: #57606a;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            if root.structured-active: Button {
                                                text: "返回结构化表格";
                                                width: 122px;
                                                clicked => { root.set-advanced-mode(false); }
                                            }
                                            Button {
                                                text: "保存参数";
                                                width: 86px;
                                                clicked => { root.save-params(param-editor.text); }
                                            }
                                        }
                                        param-editor := TextEdit {
                                            text <=> root.param-json;
                                            vertical-stretch: 1;
                                        }
                                    }

                                    // 确认（= 二版勾选）
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 6px;
                                        Button {
                                            text: "确认此决策点（= 二版检查单勾选）";
                                            horizontal-stretch: 1;
                                            primary: true;
                                            enabled: root.decision-active;
                                            clicked => { root.confirm-decision(); }
                                        }
                                        Button {
                                            text: "解除不适用";
                                            width: 100px;
                                            enabled: root.decision-exempted;
                                            clicked => { root.clear-not-applicable(); }
                                        }
                                    }
                                    // N/A 人工豁免：理由码 + 说明 + 署名（三者必填，后端校验 R3）
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 6px;
                                        na-code := LineEdit {
                                            placeholder-text: "N/A 理由码";
                                            horizontal-stretch: 1;
                                        }
                                        na-note := LineEdit {
                                            placeholder-text: "N/A 说明（必填）";
                                            horizontal-stretch: 2;
                                        }
                                        na-actor := LineEdit {
                                            placeholder-text: "署名（必填）";
                                            horizontal-stretch: 1;
                                        }
                                        Button {
                                            text: "标记不适用";
                                            width: 100px;
                                            clicked => { root.set-not-applicable(na-code.text, na-note.text, na-actor.text); }
                                        }
                                    }
                                }
                            }

                            // AI 访谈区（中栏底部；可折叠，给检查单/详情腾高度）
                            Rectangle {
                                height: root.interview-open ? 186px : 46px;
                                background: #ffffff;
                                border-color: #d8dee4;
                                border-width: 1px;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 6px;
                                        Text {
                                            text: "AI 访谈（分层确认；AI 永不代提交）";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #1f2328;
                                            vertical-alignment: center;
                                            width: 230px;
                                            overflow: elide;
                                        }
                                        Button {
                                            text: root.interview-open ? "收起" : "展开";
                                            width: 66px;
                                            clicked => { root.interview-open = !root.interview-open; }
                                        }
                                        Button { text: "下一提案"; width: 88px; clicked => { root.interview-next(); } }
                                        Text {
                                            text: root.interview-progress-text;
                                            font-size: 11px;
                                            color: #57606a;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }
                                    // 分层进度（一层一个小格：已确认/适用）
                                    if root.interview-open: HorizontalLayout {
                                        height: 16px;
                                        spacing: 4px;
                                        for level in root.interview-levels: Text {
                                            text: level.label + " " + level.text;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            color: level.current ? #bf8700 : #6e7781;
                                        }
                                    }
                                    if root.interview-open: HorizontalLayout {
                                        vertical-stretch: 1;
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: root.interview-turn-kind;
                                                font-size: 11px;
                                                color: #0969da;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.interview-decision;
                                                font-size: 11px;
                                                color: #24292f;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.interview-option;
                                                font-size: 11px;
                                                color: #24292f;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: root.interview-rationale == "" ? "" : "理由：" + root.interview-rationale;
                                                font-size: 10px;
                                                color: #57606a;
                                                vertical-stretch: 1;
                                                wrap: word-wrap;
                                            }
                                        }
                                        VerticalLayout {
                                            width: 300px;
                                            spacing: 3px;
                                            Text {
                                                text: root.interview-params-editable
                                                    ? "参数（整表提案：可改后确认 = 例外下钻）"
                                                    : "参数预览（只读）";
                                                font-size: 10px;
                                                color: #57606a;
                                                height: 14px;
                                                overflow: elide;
                                            }
                                            interview-params := TextEdit {
                                                text <=> root.interview-params-json;
                                                read-only: !root.interview-params-editable;
                                                vertical-stretch: 1;
                                            }
                                            HorizontalLayout {
                                                height: 28px;
                                                spacing: 4px;
                                                Button {
                                                    text: "确认提案";
                                                    primary: true;
                                                    enabled: root.interview-has-proposal;
                                                    clicked => { root.interview-confirm(interview-params.text); }
                                                }
                                                reject-note := LineEdit {
                                                    placeholder-text: "拒绝理由";
                                                    horizontal-stretch: 1;
                                                }
                                                Button {
                                                    text: "拒绝";
                                                    width: 64px;
                                                    enabled: root.interview-has-proposal;
                                                    clicked => { root.interview-reject(reject-note.text); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---------------- 右栏四页签 ----------------
                    Rectangle {
                        x: parent.width - 348px;
                        y: 0px;
                        width: 348px;
                        height: parent.height;
                        background: #ffffff;
                        border-color: #d0d7de;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                height: 30px;
                                spacing: 4px;
                                Button {
                                    text: "摘要";
                                    primary: root.right-tab == "summary";
                                    clicked => { root.right-tab = "summary"; }
                                }
                                Button {
                                    text: "缺失项";
                                    primary: root.right-tab == "missing";
                                    clicked => { root.right-tab = "missing"; }
                                }
                                Button {
                                    text: "风险";
                                    primary: root.right-tab == "risk";
                                    clicked => { root.right-tab = "risk"; }
                                }
                                Button {
                                    text: "校验";
                                    primary: root.right-tab == "validation";
                                    clicked => { root.right-tab = "validation"; }
                                }
                                Button {
                                    text: "风格";
                                    primary: root.right-tab == "style";
                                    clicked => {
                                        root.right-tab = "style";
                                        root.style-refresh();
                                    }
                                }
                            }

                            if root.right-tab == "summary": ListView {
                                vertical-stretch: 1;
                                for row in root.summary-rows: Rectangle {
                                    height: row.kind == "header" ? 30px : 46px;
                                    background: row.kind == "header" ? #f6f8fa : #ffffff;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: #1f2328;
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: row.kind == "bad" ? #cf222e : #57606a;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if root.right-tab == "missing": ListView {
                                vertical-stretch: 1;
                                for row in root.missing-rows: Rectangle {
                                    height: row.kind == "header" ? 30px : 50px;
                                    background: row.kind == "header" ? #f6f8fa : #ffffff;
                                    border-color: #eaeef2;
                                    border-width: row.kind == "header" ? 0px : 1px;
                                    if row.target != "": TouchArea {
                                        clicked => { root.select-decision(row.target); }
                                    }
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: #1f2328;
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: #cf222e;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if root.right-tab == "risk": ListView {
                                vertical-stretch: 1;
                                for row in root.risk-rows: Rectangle {
                                    height: row.kind == "header" ? 30px : 52px;
                                    background: row.kind == "header" ? #f6f8fa : #ffffff;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: row.kind == "bad" ? #cf222e : #1f2328;
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: #57606a;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if root.right-tab == "validation": VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 5px;
                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 4px;
                                    Button { text: "四门预检"; clicked => { root.freeze-check(); } }
                                    Button { text: "AI 红队"; clicked => { root.run-red-team(); } }
                                    Button {
                                        text: root.freeze-ready ? "执行冻结" : "执行冻结（需全绿）";
                                        primary: true;
                                        enabled: root.freeze-ready;
                                        clicked => { root.freeze-run(); }
                                    }
                                }
                                if root.freeze-hint != "": HorizontalLayout {
                                    height: 28px;
                                    spacing: 4px;
                                    Text {
                                        text: root.freeze-hint;
                                        font-size: 11px;
                                        color: #1a7f37;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Button {
                                        text: "前往开发流水线";
                                        width: 126px;
                                        clicked => { root.active-view = "pipeline"; }
                                    }
                                }
                                ListView {
                                    vertical-stretch: 1;
                                    for row in root.validation-rows: Rectangle {
                                        height: row.kind == "header" ? 30px : 46px;
                                        background: row.kind == "header" ? #f6f8fa : #ffffff;
                                        VerticalLayout {
                                            padding: 4px;
                                            spacing: 1px;
                                            Text {
                                                text: row.title;
                                                font-size: row.kind == "header" ? 12px : 11px;
                                                font-weight: row.kind == "header" ? 700 : 400;
                                                color: row.kind == "bad"
                                                    ? #cf222e
                                                    : (row.kind == "ok" ? #1a7f37 : #1f2328);
                                                overflow: elide;
                                            }
                                            if row.kind != "header": Text {
                                                text: row.text;
                                                font-size: 10px;
                                                color: #57606a;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }

                            // ---------- 「风格」页签：设计阶段美术风格锚点门（册 08 §2）----------
                            if root.right-tab == "style": VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 4px;

                                Text {
                                    text: root.style-summary;
                                    height: 42px;
                                    font-size: 11px;
                                    color: #1f2328;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.style-readiness;
                                    height: 42px;
                                    font-size: 10px;
                                    color: root.style-ready ? #1a7f37 : #cf222e;
                                    wrap: word-wrap;
                                }
                                if root.style-gate-hint != "": Text {
                                    text: root.style-gate-hint;
                                    height: 54px;
                                    font-size: 10px;
                                    color: #9a6700;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 4px;
                                    Button {
                                        text: "生成方向";
                                        primary: true;
                                        enabled: root.style-can-generate && !root.style-running;
                                        clicked => { root.style-generate(false); }
                                    }
                                    Button {
                                        text: root.style-ready ? "重新选择" : "推翻重生成";
                                        enabled: root.style-can-generate && !root.style-running;
                                        clicked => { root.style-generate(true); }
                                    }
                                    Button { text: "刷新"; width: 56px; clicked => { root.style-refresh(); } }
                                }
                                if root.style-running: Text {
                                    text: "生成中…（后台线程，界面保持可用；失败会如实报原因，不产占位图）";
                                    height: 30px;
                                    font-size: 10px;
                                    color: #0969da;
                                    wrap: word-wrap;
                                }

                                // 风格网格：单击选中，双击看大图（右栏宽 348px，故单列卡片）
                                ListView {
                                    vertical-stretch: 1;
                                    for card in root.style-cards: Rectangle {
                                        height: 116px;
                                        background: card.active ? #eef4ff : #ffffff;
                                        border-color: card.selected ? #1a7f37 : #eaeef2;
                                        border-width: card.selected ? 2px : 1px;
                                        border-radius: 4px;

                                        TouchArea {
                                            clicked => { root.style-select(card.id); }
                                            double-clicked => { root.style-open-viewer(card.id); }
                                        }
                                        HorizontalLayout {
                                            padding: 4px;
                                            spacing: 5px;
                                            Rectangle {
                                                width: 96px;
                                                background: #f6f8fa;
                                                border-color: #d8dee4;
                                                border-width: 1px;
                                                if card.has-image: Image {
                                                    source: card.image;
                                                    width: parent.width - 4px;
                                                    height: parent.height - 4px;
                                                    image-fit: contain;
                                                }
                                                if !card.has-image: Text {
                                                    text: "无预览图";
                                                    font-size: 10px;
                                                    color: #6e7781;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 1px;
                                                horizontal-stretch: 1;
                                                Text {
                                                    text: card.badge + card.title;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #1f2328;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: card.fit;
                                                    font-size: 10px;
                                                    color: card.fit-kind == "caution"
                                                        ? #9a6700
                                                        : (card.fit-kind == "ok" ? #1a7f37 : #6e7781);
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: card.prompt-origin + "：" + card.prompt-summary;
                                                    font-size: 10px;
                                                    color: #57606a;
                                                    wrap: word-wrap;
                                                    vertical-stretch: 1;
                                                }
                                                Text {
                                                    text: card.palette;
                                                    font-size: 10px;
                                                    color: #6e7781;
                                                    overflow: elide;
                                                }
                                                if card.failure != "": Text {
                                                    text: card.failure;
                                                    font-size: 10px;
                                                    color: #cf222e;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }

                                // 选中方向：改词重生成 + attended 确认（署名与结论由后端判必填）
                                Rectangle {
                                    height: 196px;
                                    background: #f6f8fa;
                                    border-color: #d8dee4;
                                    border-width: 1px;
                                    border-radius: 4px;
                                    VerticalLayout {
                                        padding: 5px;
                                        spacing: 3px;
                                        Text {
                                            text: root.style-selected == ""
                                                ? "（未选择方向：单击卡片选中，双击看大图）"
                                                : "方向 " + root.style-selected;
                                            height: 16px;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #1f2328;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.style-prompt-origin;
                                            height: 14px;
                                            font-size: 10px;
                                            color: #57606a;
                                            overflow: elide;
                                        }
                                        style-prompt-edit := TextEdit {
                                            text <=> root.style-prompt;
                                            height: 54px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            height: 26px;
                                            spacing: 3px;
                                            Button {
                                                text: "改词重生成";
                                                enabled: root.style-selected != "" && root.style-can-generate && !root.style-running;
                                                clicked => { root.style-regenerate(root.style-selected, style-prompt-edit.text); }
                                            }
                                            Button {
                                                text: "回到派生提示词";
                                                enabled: root.style-selected != "" && root.style-can-generate && !root.style-running;
                                                clicked => { root.style-clear-prompt(root.style-selected); }
                                            }
                                            Button {
                                                text: "看大图";
                                                width: 64px;
                                                enabled: root.style-selected != "";
                                                clicked => { root.style-open-viewer(root.style-selected); }
                                            }
                                        }
                                        HorizontalLayout {
                                            height: 26px;
                                            spacing: 3px;
                                            style-actor-edit := LineEdit {
                                                placeholder-text: "确认人署名（必填）";
                                                width: 118px;
                                            }
                                            style-note-edit := LineEdit {
                                                placeholder-text: "确认结论（必填）";
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Button {
                                            text: "确认并锁定风格锚点（另立新版）";
                                            height: 26px;
                                            primary: true;
                                            enabled: root.style-selected != "" && !root.style-running;
                                            clicked => {
                                                root.style-confirm(
                                                    root.style-selected,
                                                    style-actor-edit.text,
                                                    style-note-edit.text
                                                );
                                            }
                                        }
                                    }
                                }

                                if root.style-lock-rows.length > 0: ListView {
                                    height: 104px;
                                    for row in root.style-lock-rows: Rectangle {
                                        height: row.kind == "header" ? 24px : 40px;
                                        background: row.kind == "header" ? #eaf5ea : #ffffff;
                                        VerticalLayout {
                                            padding: 3px;
                                            Text {
                                                text: row.title;
                                                font-size: row.kind == "header" ? 11px : 10px;
                                                font-weight: row.kind == "header" ? 700 : 400;
                                                color: row.kind == "bad" ? #cf222e : #1f2328;
                                                overflow: elide;
                                            }
                                            if row.kind != "header": Text {
                                                text: row.text;
                                                font-size: 10px;
                                                color: #57606a;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 二、开发流水线（全版图：C0-C6 实跑 + P0-P5 占位，不断头）
            // -----------------------------------------------------------------
            if root.active-view == "pipeline": Rectangle {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                background: transparent;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 300px;
                    height: parent.height;
                    background: #ffffff;
                    border-color: #d0d7de;
                    border-width: 1px;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: "流程版图";
                            height: 22px;
                            font-size: 13px;
                            font-weight: 700;
                            color: #1f2328;
                        }
                        Text {
                            text: "设计冻结 → C0-C6（文档编译段，已实现）→ P0-P5（开发执行段，Phase 2）";
                            height: 46px;
                            font-size: 11px;
                            color: #57606a;
                            wrap: word-wrap;
                        }
                        // 范围运行：段清单来自 registry（root.stage-ids），不在 UI 里硬编码段名。
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            Text { text: "从"; width: 18px; font-size: 11px; color: #57606a; vertical-alignment: center; }
                            from-box := ComboBox {
                                model: root.stage-ids;
                                current-value: root.pipeline-from;
                                horizontal-stretch: 1;
                                selected(value) => { root.pipeline-from = value; }
                            }
                            Text { text: "到"; width: 18px; font-size: 11px; color: #57606a; vertical-alignment: center; }
                            to-box := ComboBox {
                                model: root.stage-ids;
                                current-value: root.pipeline-to;
                                horizontal-stretch: 1;
                                selected(value) => { root.pipeline-to = value; }
                            }
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            Button {
                                text: "运行选定范围";
                                primary: true;
                                horizontal-stretch: 1;
                                enabled: !root.pipeline-running;
                                clicked => { root.pipeline-run-range(from-box.current-value, to-box.current-value); }
                            }
                            Button {
                                text: "停止运行";
                                width: 92px;
                                enabled: root.pipeline-running;
                                clicked => { root.pipeline-stop(); }
                            }
                        }
                        Text {
                            text: root.pipeline-run-hint;
                            height: 58px;
                            font-size: 10px;
                            color: root.pipeline-running ? #bf8700 : #6e7781;
                            wrap: word-wrap;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for stage in root.stages: Rectangle {
                                height: 62px;
                                background: stage.placeholder ? #f6f8fa : (stage.id == root.artifact-stage ? #ddf4ff : #ffffff);
                                border-color: stage.id == root.artifact-stage ? #54aeff : #eaeef2;
                                border-width: 1px;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;
                                    Text {
                                        text: stage.segment + " " + stage.id + " · " + stage.name;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: stage.placeholder ? #6e7781 : #1f2328;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: stage.running ? "▶ " + stage.status : stage.status;
                                        font-size: 10px;
                                        color: stage.running ? #0969da : (stage.waiting ? #bf8700 : #57606a);
                                        overflow: elide;
                                    }
                                    Text {
                                        text: stage.duration;
                                        font-size: 10px;
                                        color: #6e7781;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: 310px;
                    y: 0px;
                    width: parent.width - 310px;
                    height: parent.height;
                    background: #ffffff;
                    border-color: #d0d7de;
                    border-width: 1px;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: "阶段详情与人工门";
                            height: 22px;
                            font-size: 13px;
                            font-weight: 700;
                            color: #1f2328;
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            confirm-note := LineEdit {
                                placeholder-text: "人工确认备注（C5 风格门 / C6 签收门）";
                                horizontal-stretch: 1;
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for stage in root.stages: Rectangle {
                                height: 62px;
                                background: stage.placeholder ? #f6f8fa : (stage.id == root.artifact-stage ? #ddf4ff : #ffffff);
                                border-color: stage.id == root.artifact-stage ? #54aeff : #eaeef2;
                                border-width: 1px;
                                HorizontalLayout {
                                    padding: 5px;
                                    spacing: 6px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text {
                                            text: stage.segment + " " + stage.id + " · " + stage.name;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: stage.placeholder ? #6e7781 : #1f2328;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: stage.summary;
                                            font-size: 10px;
                                            color: #57606a;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: (stage.running ? "▶ " : "") + stage.status + "   " + stage.duration;
                                            font-size: 10px;
                                            color: stage.running ? #0969da : (stage.waiting ? #bf8700 : #6e7781);
                                            overflow: elide;
                                        }
                                    }
                                    if stage.waiting: Button {
                                        text: "人工确认";
                                        width: 88px;
                                        clicked => { root.pipeline-confirm(stage.id, confirm-note.text); }
                                    }
                                    // 产物入口与重跑：可用性由后端运行状态推出（没跑过的段两个按钮都不出）。
                                    if stage.can-inspect: Button {
                                        text: "产物";
                                        width: 62px;
                                        clicked => { root.pipeline-artifact(stage.id); }
                                    }
                                    if stage.can-rerun: Button {
                                        text: "重跑";
                                        width: 62px;
                                        enabled: !root.pipeline-running;
                                        clicked => { root.pipeline-rerun-arm(stage.id); }
                                    }
                                }
                            }
                        }

                        // 重跑二次确认条：先把「连带作废什么」摆出来，确认后才真跑。
                        if root.rerun-armed-stage != "": Rectangle {
                            height: 104px;
                            background: #fff8c5;
                            border-color: #d4a72c;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Text {
                                    text: root.rerun-warning;
                                    vertical-stretch: 1;
                                    font-size: 11px;
                                    color: #7d4e00;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    height: 28px;
                                    spacing: 6px;
                                    Button {
                                        text: "确认重跑 " + root.rerun-armed-stage;
                                        width: 168px;
                                        enabled: !root.pipeline-running;
                                        clicked => { root.pipeline-rerun-confirm(root.rerun-armed-stage, to-box.current-value); }
                                    }
                                    Button {
                                        text: "取消";
                                        width: 76px;
                                        clicked => { root.rerun-armed-stage = ""; }
                                    }
                                    Text {
                                        text: "重跑后会从该段继续跑到「到」下拉选中的段";
                                        font-size: 10px;
                                        color: #7d4e00;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        // 重跑回执：重置段清单 + 作废署名逐条在案。
                        if root.reset-rows.length > 0: Rectangle {
                            height: 96px;
                            background: #ffffff;
                            border-color: #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            ListView {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                for row in root.reset-rows: Rectangle {
                                    height: row.kind == "header" ? 22px : 30px;
                                    background: transparent;
                                    VerticalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: row.kind == "bad" ? #cf222e : #1f2328;
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: #57606a;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }

                        // 阶段产物详情（document.md 预览 + 双格式路径/sha256）
                        Rectangle {
                            height: 236px;
                            background: #ffffff;
                            border-color: #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Text {
                                    text: root.artifact-title == "" ? "阶段产物：点任一已跑过阶段的「产物」按钮查看 document.md 与 contract.json" : root.artifact-title;
                                    height: 18px;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #1f2328;
                                    overflow: elide;
                                }
                                for row in root.artifact-rows: VerticalLayout {
                                    height: 30px;
                                    Text {
                                        text: row.title;
                                        font-size: 11px;
                                        color: row.kind == "bad" ? #cf222e : #1a7f37;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.text;
                                        font-size: 10px;
                                        color: #57606a;
                                        overflow: elide;
                                    }
                                }
                                if root.artifact-hint != "": Text {
                                    text: root.artifact-hint;
                                    height: 16px;
                                    font-size: 10px;
                                    color: #bf8700;
                                    overflow: elide;
                                }
                                artifact-view := TextEdit {
                                    vertical-stretch: 1;
                                    read-only: true;
                                    text: root.artifact-doc;
                                }
                            }
                        }

                        Rectangle {
                            height: 92px;
                            background: #f6f8fa;
                            border-color: #d8dee4;
                            border-width: 1px;
                            border-radius: 6px;
                            Text {
                                x: 8px;
                                y: 6px;
                                width: parent.width - 16px;
                                height: parent.height - 12px;
                                text: root.pipeline-note;
                                font-size: 11px;
                                color: #57606a;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 三、补充开发（骨架页）
            // -----------------------------------------------------------------
            if root.active-view == "patch": Rectangle {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        Text { text: "补充开发"; font-size: 17px; font-weight: 700; color: #1f2328; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: root.change-summary; font-size: 11px; color: #57606a; vertical-alignment: center; overflow: elide; }
                        Button { text: "刷新"; width: 72px; clicked => { root.change-refresh(); } }
                    }
                    Text {
                        text: "四版语义：冻结之后的变更走「追加需求 → 影响分析（标注受影响 C0..C6 段）→ 排期 → 应用」，不在冻结产物上原地改。推进需署名+结论（R3）。";
                        height: 30px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    // 录入表单
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        chg-title := LineEdit { placeholder-text: "变更标题"; horizontal-stretch: 2; }
                        chg-requester := LineEdit { placeholder-text: "申请人（署名）"; horizontal-stretch: 1; }
                        chg-desc := LineEdit { placeholder-text: "描述（可选）"; horizontal-stretch: 2; }
                        Button { text: "登记变更"; width: 88px; clicked => { root.change-add(chg-title.text, chg-requester.text, chg-desc.text); } }
                    }
                    // 影响分析 / 推进 共享署名行
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        chg-segments := LineEdit { placeholder-text: "受影响段 CSV，例如 C2,C3"; horizontal-stretch: 1; }
                        chg-actor := LineEdit { placeholder-text: "评审人（推进署名）"; horizontal-stretch: 1; }
                        chg-note := LineEdit { placeholder-text: "结论/理由（推进署名）"; horizontal-stretch: 2; }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.change-rows: Rectangle {
                            height: 62px;
                            background: #ffffff;
                            border-color: #eaeef2;
                            border-width: 1px;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: row.title + "  · " + row.requester; font-size: 12px; font-weight: 700; color: #1f2328; overflow: elide; }
                                    Text {
                                        text: "[" + row.status + "]  受影响段：" + row.segments;
                                        font-size: 10px;
                                        color: row.status-kind == "bad" ? #cf222e : (row.status-kind == "good" ? #1a7f37 : #57606a);
                                        overflow: elide;
                                    }
                                    Text { text: row.signed; font-size: 10px; color: #6e7781; overflow: elide; }
                                }
                                if row.can-impact: Button { text: "影响分析"; width: 78px; clicked => { root.change-impact(row.id, chg-segments.text); } }
                                if row.can-advance: Button { text: row.next-label; width: 72px; clicked => { root.change-advance(row.id, row.next-token, chg-actor.text, chg-note.text); } }
                                if row.can-advance: Button { text: "拒绝"; width: 60px; clicked => { root.change-advance(row.id, "rejected", chg-actor.text, chg-note.text); } }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 四、打包阶段（骨架页）
            // -----------------------------------------------------------------
            if root.active-view == "package": Rectangle {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        Text { text: "打包阶段"; font-size: 17px; font-weight: 700; color: #1f2328; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: root.deliver-summary; font-size: 11px; color: #57606a; vertical-alignment: center; overflow: elide; }
                    }
                    Text {
                        text: "四版归宿：文档集交付 = 清点最新冻结版的 C0-C6 产物、算 sha256、标完整性（本视图落地）；游戏构建 / 引擎工程 / 运行时验证属 P0-P5（Phase 2，下方占位说明）。";
                        height: 30px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        Button { text: "打包文档集（最新冻结版）"; width: 190px; primary: true; clicked => { root.deliver-package(); } }
                        Button { text: "刷新清点"; width: 88px; clicked => { root.deliver-refresh(); } }
                        Button { text: "存档体检"; width: 88px; clicked => { root.project-doctor(); } }
                        Text {
                            text: root.doctor-summary;
                            font-size: 11px;
                            color: #57606a;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    // 体检明细（`project doctor` 上提到门面后，CLI 与桌面共用同一份判定）
                    if root.doctor-rows.length > 0: Rectangle {
                        height: 108px;
                        background: #ffffff;
                        border-color: #d8dee4;
                        border-width: 1px;
                        border-radius: 6px;
                        ListView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            for row in root.doctor-rows: Rectangle {
                                height: row.kind == "header" ? 22px : 32px;
                                background: transparent;
                                VerticalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: row.title;
                                        font-size: row.kind == "header" ? 12px : 11px;
                                        font-weight: row.kind == "header" ? 700 : 400;
                                        color: row.kind == "bad" ? #cf222e : (row.kind == "ok" ? #1a7f37 : #1f2328);
                                        overflow: elide;
                                    }
                                    if row.kind != "header": Text {
                                        text: row.text;
                                        font-size: 10px;
                                        color: #57606a;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    // 文档集清单：逐段 C0-C6
                    ListView {
                        vertical-stretch: 1;
                        for row in root.deliver-rows: Rectangle {
                            height: 34px;
                            background: #ffffff;
                            border-color: #eaeef2;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text { text: row.stage; width: 48px; font-size: 12px; font-weight: 700; color: row.present ? #1a7f37 : #cf222e; vertical-alignment: center; }
                                Text { text: row.present ? "齐备" : "缺失"; width: 48px; font-size: 11px; color: row.present ? #1a7f37 : #cf222e; vertical-alignment: center; }
                                Text { text: row.detail; font-size: 10px; color: #57606a; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }
                        }
                    }
                    // 整包导出/导入（.adm4proj）
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        pkg-export-path := LineEdit { placeholder-text: "导出路径，例如 D:\\proj.adm4proj"; horizontal-stretch: 1; }
                        Button { text: "导出 .adm4proj"; width: 118px; clicked => { root.project-export(pkg-export-path.text); } }
                    }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        pkg-import-path := LineEdit { placeholder-text: "导入路径 .adm4proj"; horizontal-stretch: 1; }
                        pkg-import-name := LineEdit { placeholder-text: "新项目名"; width: 200px; }
                        Button { text: "导入为新项目"; width: 118px; clicked => { root.project-import(pkg-import-path.text, pkg-import-name.text); } }
                    }
                    Text {
                        text: "Phase 2 占位（P0-P5，执行器另行立项）：游戏构建 / 引擎工程导出 / 运行时验证 / 发布包。二版「暂存发布 · 诊断 · 构建包 · 引擎构建 · 运行时验证」在此有归宿，本期不放不可用按钮。";
                        height: 44px;
                        font-size: 10px;
                        color: #8c959f;
                        wrap: word-wrap;
                    }
                }
            }

            // -----------------------------------------------------------------
            // 五、运行日志（接现有 RunLog 数据）
            // -----------------------------------------------------------------
            if root.active-view == "logs": Rectangle {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        Text {
                            text: "运行日志";
                            width: 90px;
                            font-size: 17px;
                            font-weight: 700;
                            color: #1f2328;
                            vertical-alignment: center;
                        }
                        log-filter := LineEdit {
                            placeholder-text: "过滤：类别或关键字（留空 = 全部）";
                            width: 300px;
                        }
                        Button { text: "刷新"; width: 76px; clicked => { root.refresh-logs(log-filter.text); } }
                        log-path := LineEdit {
                            placeholder-text: "导出路径，例如 D:\\runlog.md";
                            horizontal-stretch: 1;
                        }
                        Button { text: "导出"; width: 76px; clicked => { root.export-logs(log-path.text); } }
                    }
                    Text {
                        text: "四版语义：日志是 jsonl 追加的审计流，不提供「清空」（清空会破坏可追溯性）——二版的清空按钮在此照实省略。";
                        height: 30px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for log in root.logs: Rectangle {
                            height: 30px;
                            background: #ffffff;
                            border-color: #eaeef2;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 8px;
                                Text {
                                    text: log.at;
                                    width: 178px;
                                    font-size: 11px;
                                    color: #6e7781;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "[" + log.category + "]";
                                    width: 92px;
                                    font-size: 11px;
                                    color: #0969da;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: log.message;
                                    font-size: 11px;
                                    color: #24292f;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 六、SDK 知识库（骨架页）
            // -----------------------------------------------------------------
            if root.active-view == "sdk": Rectangle {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #d0d7de;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        Text { text: "SDK 知识库"; font-size: 17px; font-weight: 700; color: #1f2328; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: root.sdk-counts; font-size: 11px; color: #57606a; vertical-alignment: center; }
                        Button { text: "刷新"; width: 72px; clicked => { root.sdk-refresh(); } }
                    }
                    Text {
                        text: "四版归宿：SDK 资源登记 + 三态审批流（待审 → 批准/拒绝，署名+意见必填）。审批产物是 Phase 2 构建集成的前置——未批准的资源不得进入构建。全局共享，跨项目一致。";
                        height: 30px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    // 登记表单
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        sdk-name := LineEdit { placeholder-text: "资源名，例如 DOTween"; horizontal-stretch: 1; }
                        sdk-url := LineEdit { placeholder-text: "URL/来源"; horizontal-stretch: 2; }
                        sdk-cat := LineEdit { placeholder-text: "类别（默认 custom）"; width: 150px; }
                        sdk-purpose := LineEdit { placeholder-text: "取用目的"; horizontal-stretch: 1; }
                        Button { text: "提交待审"; width: 88px; clicked => { root.sdk-add(sdk-name.text, sdk-url.text, sdk-cat.text, sdk-purpose.text); } }
                    }
                    // 审批共享署名行
                    HorizontalLayout {
                        height: 30px;
                        spacing: 6px;
                        sdk-reviewer := LineEdit { placeholder-text: "评审人（审批署名）"; horizontal-stretch: 1; }
                        sdk-review-note := LineEdit { placeholder-text: "审核结论/拒绝理由（必填）"; horizontal-stretch: 2; }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.sdk-rows: Rectangle {
                            height: 56px;
                            background: #ffffff;
                            border-color: #eaeef2;
                            border-width: 1px;
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text { text: row.name + "  [" + row.category + "]"; font-size: 12px; font-weight: 700; color: #1f2328; overflow: elide; }
                                    Text { text: row.url + "  · " + row.purpose; font-size: 10px; color: #57606a; overflow: elide; }
                                    Text {
                                        text: row.status + "  " + row.signed;
                                        font-size: 10px;
                                        color: row.status-kind == "bad" ? #cf222e : (row.status-kind == "good" ? #1a7f37 : #bf8700);
                                        overflow: elide;
                                    }
                                }
                                if row.pending: Button { text: "批准"; width: 60px; clicked => { root.sdk-approve(row.id, sdk-reviewer.text, sdk-review-note.text); } }
                                if row.pending: Button { text: "拒绝"; width: 60px; clicked => { root.sdk-reject(row.id, sdk-reviewer.text, sdk-review-note.text); } }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 覆盖面板一：存档管理（项目列表 / 新建项目）
            // -----------------------------------------------------------------
            if root.active-view == "design" && root.archive-panel-open: Rectangle {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #54aeff;
                border-width: 2px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Text {
                            text: "存档管理（V4 事务自动保存：每次变更即原子提交，无手动保存按钮）";
                            font-size: 14px;
                            font-weight: 700;
                            color: #1f2328;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Button { text: "刷新列表"; width: 96px; clicked => { root.refresh-projects(); } }
                        Button { text: "体检当前项目"; width: 112px; clicked => { root.project-doctor(); } }
                        Button { text: "关闭"; width: 76px; clicked => { root.archive-panel-open = false; } }
                    }
                    if root.doctor-rows.length > 0: Rectangle {
                        height: 92px;
                        background: #ffffff;
                        border-color: #d8dee4;
                        border-width: 1px;
                        border-radius: 6px;
                        ListView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            for row in root.doctor-rows: Rectangle {
                                height: row.kind == "header" ? 22px : 32px;
                                background: transparent;
                                VerticalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: row.title;
                                        font-size: row.kind == "header" ? 12px : 11px;
                                        font-weight: row.kind == "header" ? 700 : 400;
                                        color: row.kind == "bad" ? #cf222e : (row.kind == "ok" ? #1a7f37 : #1f2328);
                                        overflow: elide;
                                    }
                                    if row.kind != "header": Text {
                                        text: row.text;
                                        font-size: 10px;
                                        color: #57606a;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        Text {
                            text: "新建项目";
                            width: 68px;
                            font-size: 12px;
                            color: #57606a;
                            vertical-alignment: center;
                        }
                        new-name := LineEdit { placeholder-text: "项目名"; width: 220px; }
                        pack-box := ComboBox { model: root.packs; width: 190px; }
                        depth-box := ComboBox { model: ["L4", "L5", "L6"]; current-value: "L5"; width: 90px; }
                        Button {
                            text: "创建";
                            width: 88px;
                            primary: true;
                            clicked => { root.create-project(new-name.text, pack-box.current-value, depth-box.current-value); }
                        }
                        Text {
                            text: "深度档 = L4/L5/L6（最低 L4）；创建后可在模板面板做认证模板预填。";
                            font-size: 11px;
                            color: #6e7781;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    // 破坏性操作：重置设计工作台（二版 reset-design-workbench 的四版归宿）
                    HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        Text {
                            text: "重置工作台";
                            width: 68px;
                            font-size: 12px;
                            color: #cf222e;
                            vertical-alignment: center;
                        }
                        reset-actor := LineEdit { placeholder-text: "操作人（署名，必填）"; width: 190px; }
                        reset-note := LineEdit { placeholder-text: "重置理由（必填，进审计日志）"; horizontal-stretch: 1; }
                        Button {
                            text: "重置当前项目…";
                            width: 128px;
                            clicked => { root.workbench-reset-arm(); }
                        }
                    }
                    if root.reset-armed: Rectangle {
                        height: 96px;
                        background: #fff8c5;
                        border-color: #d4a72c;
                        border-width: 1px;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            Text {
                                text: root.reset-warning;
                                vertical-stretch: 1;
                                font-size: 11px;
                                color: #7d4e00;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                height: 28px;
                                spacing: 6px;
                                Button {
                                    text: "确认重置（不可撤销）";
                                    width: 168px;
                                    clicked => { root.workbench-reset(reset-actor.text, reset-note.text); }
                                }
                                Button {
                                    text: "取消";
                                    width: 76px;
                                    clicked => { root.reset-armed = false; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    if root.reset-result != "": Text {
                        text: root.reset-result;
                        height: 46px;
                        font-size: 11px;
                        color: #1a7f37;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "项目列表（点击载入）";
                        height: 22px;
                        font-size: 12px;
                        font-weight: 700;
                        color: #1f2328;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for project in root.projects: Rectangle {
                            height: 44px;
                            background: project.active ? #ddf4ff : #ffffff;
                            border-color: project.active ? #54aeff : #eaeef2;
                            border-width: 1px;
                            TouchArea { clicked => { root.open-project(project.id); } }
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 10px;
                                Text {
                                    text: project.name;
                                    width: 30%;
                                    font-size: 12px;
                                    color: #1f2328;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: project.id;
                                    width: 42%;
                                    font-size: 11px;
                                    color: #6e7781;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: project.updated;
                                    font-size: 11px;
                                    color: #6e7781;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 覆盖面板二：模板查看/预填 + 逆向维护产线五步 + 对照
            // -----------------------------------------------------------------
            if root.active-view == "design" && root.template-panel-open: Rectangle {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #54aeff;
                border-width: 2px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Text {
                            text: "模板：查看 / 预填（仅认证模板）/ 逆向维护产线";
                            font-size: 14px;
                            font-weight: 700;
                            color: #1f2328;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button { text: "关闭"; width: 76px; clicked => { root.template-panel-open = false; } }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 10px;

                        // 左：品类包 + 模板列表
                        VerticalLayout {
                            width: 330px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 32px;
                                spacing: 6px;
                                reverse-pack-box := ComboBox {
                                    model: root.packs;
                                    horizontal-stretch: 1;
                                    selected(value) => { root.reverse-select-pack(value); }
                                }
                                Button { text: "刷新"; width: 72px; clicked => { root.reverse-refresh(); } }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for template in root.template-list: Rectangle {
                                    height: 66px;
                                    background: template.active ? #ddf4ff : #ffffff;
                                    border-color: template.active ? #54aeff : #eaeef2;
                                    border-width: 1px;
                                    TouchArea { clicked => { root.reverse-select-template(template.id); } }
                                    VerticalLayout {
                                        padding: 5px;
                                        spacing: 1px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text {
                                                text: template.id;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: #1f2328;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: template.status;
                                                font-size: 11px;
                                                width: 84px;
                                                horizontal-alignment: right;
                                                color: template.status == "已认证" ? #1a7f37 : #bf8700;
                                            }
                                        }
                                        Text {
                                            text: template.game + " · " + template.depth;
                                            font-size: 10px;
                                            color: #57606a;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: template.answers;
                                            font-size: 10px;
                                            color: #6e7781;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 32px;
                                spacing: 6px;
                                Button {
                                    text: "预填到当前项目";
                                    primary: true;
                                    horizontal-stretch: 1;
                                    clicked => { root.template-prefill(); }
                                }
                                Button {
                                    text: "与当前项目对照";
                                    horizontal-stretch: 1;
                                    clicked => { root.reverse-compare(); }
                                }
                            }
                        }

                        // 中：产线五步
                        VerticalLayout {
                            width: 430px;
                            spacing: 6px;
                            Text {
                                text: root.reverse-selected;
                                height: 20px;
                                font-size: 12px;
                                color: #1f2328;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                height: 24px;
                                spacing: 4px;
                                for step[step-index] in root.template-steps: Text {
                                    text: (step-index == 0 ? "" : "→ ") + step.name;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    color: step.reached ? #1a7f37 : (step.current ? #bf8700 : #6e7781);
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            GroupBox {
                                title: "S0 新建草稿";
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 4px;
                                        draft-id := LineEdit { placeholder-text: "模板 id（snake_case）"; horizontal-stretch: 1; }
                                        draft-depth := ComboBox { model: ["L4", "L5", "L6"]; current-value: "L5"; width: 84px; }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 4px;
                                        draft-game := LineEdit { placeholder-text: "逆向目标游戏名"; horizontal-stretch: 1; }
                                        draft-aliases := LineEdit { placeholder-text: "别名（逗号分隔）"; horizontal-stretch: 1; }
                                        Button {
                                            text: "建草稿";
                                            width: 84px;
                                            clicked => { root.reverse-new-draft(draft-id.text, draft-game.text, draft-aliases.text, draft-depth.current-value); }
                                        }
                                    }
                                }
                            }
                            GroupBox {
                                title: "另存为模板（当前项目 → 模板；审核人与结论必填，R3）";
                                VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 4px;
                                        tpl-export-id := LineEdit { placeholder-text: "新模板 id（snake_case）"; horizontal-stretch: 1; }
                                        tpl-export-name := LineEdit { placeholder-text: "模板展示名（留空=项目名）"; horizontal-stretch: 1; }
                                        tpl-export-aliases := LineEdit { placeholder-text: "别名（逗号分隔）"; width: 130px; }
                                    }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 4px;
                                        tpl-export-reviewer := LineEdit { placeholder-text: "审核人署名"; width: 130px; }
                                        tpl-export-note := LineEdit { placeholder-text: "审核结论"; horizontal-stretch: 1; }
                                        Button {
                                            text: "另存为模板";
                                            width: 96px;
                                            clicked => {
                                                root.template-export(tpl-export-id.text, tpl-export-name.text, tpl-export-aliases.text, tpl-export-reviewer.text, tpl-export-note.text);
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.template-export-text == "" ? "只导出「已确认」的决策点；未确认的点会被跳过并如实计数。另存结果落「已审核」态，需再走 S5 认证入库才能预填。" : root.template-export-text;
                                        height: 56px;
                                        font-size: 10px;
                                        color: root.template-export-text == "" ? #6e7781 : #1a7f37;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            GroupBox {
                                title: "S1 语料检索（本地目录，零网络）";
                                VerticalLayout {
                                    spacing: 4px;
                                    corpus-dir := LineEdit { placeholder-text: "语料目录路径"; height: 32px; }
                                    HorizontalLayout {
                                        height: 32px;
                                        spacing: 4px;
                                        corpus-question := LineEdit { placeholder-text: "决策问题"; horizontal-stretch: 1; }
                                        corpus-keywords := LineEdit { placeholder-text: "关键词（逗号分隔）"; horizontal-stretch: 1; }
                                        Button {
                                            text: "检索";
                                            width: 72px;
                                            clicked => { root.reverse-search(corpus-dir.text, corpus-question.text, corpus-keywords.text); }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 32px;
                                spacing: 6px;
                                Button { text: "S2 AI 映射"; clicked => { root.reverse-map(); } }
                                Button { text: "S3 交叉核验"; clicked => { root.reverse-crosscheck(); } }
                            }
                            GroupBox {
                                title: "S4 人工审核（署名与结论必填，R3）";
                                HorizontalLayout {
                                    height: 32px;
                                    spacing: 4px;
                                    reviewer-name := LineEdit { placeholder-text: "评审人署名"; width: 130px; }
                                    review-note := LineEdit { placeholder-text: "审核结论"; horizontal-stretch: 1; }
                                    Button {
                                        text: "审核通过";
                                        width: 96px;
                                        clicked => { root.reverse-review(reviewer-name.text, review-note.text); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 32px;
                                spacing: 6px;
                                Button { text: "S5 认证入库"; primary: true; clicked => { root.reverse-certify(); } }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }

                        // 右：冲突清单 + 对照结果
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text {
                                text: "交叉核验冲突（待人工裁决）";
                                height: 20px;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1f2328;
                            }
                            ListView {
                                vertical-stretch: 1;
                                for conflict in root.template-conflicts: Rectangle {
                                    height: 46px;
                                    background: #ffffff;
                                    border-color: #eaeef2;
                                    border-width: 1px;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: "✘ " + conflict.decision;
                                            font-size: 11px;
                                            color: #cf222e;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: conflict.reason;
                                            font-size: 10px;
                                            color: #57606a;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.compare-title == "" ? "对照结果（先打开项目并选已认证模板）" : root.compare-title;
                                height: 32px;
                                font-size: 11px;
                                color: #1f2328;
                                wrap: word-wrap;
                            }
                            ListView {
                                vertical-stretch: 1;
                                for entry in root.compare-rows: Rectangle {
                                    height: 46px;
                                    background: #ffffff;
                                    border-color: #eaeef2;
                                    border-width: 1px;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Text {
                                                text: entry.decision;
                                                width: 34%;
                                                font-size: 11px;
                                                color: #1f2328;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: entry.template-option;
                                                width: 26%;
                                                font-size: 11px;
                                                color: #57606a;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: entry.project-option;
                                                width: 26%;
                                                font-size: 11px;
                                                color: #57606a;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: entry.same ? "✔" : "✘";
                                                font-size: 11px;
                                                color: entry.same ? #1a7f37 : #cf222e;
                                            }
                                        }
                                        Text {
                                            text: entry.params;
                                            font-size: 10px;
                                            color: #6e7781;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 覆盖面板三：系统组合（W7）——系统实例/档位、私有模块、组合校验、署名形态确认
            //
            // 全窗覆盖而不是塞右栏：实例清单 + 组合报告 + 确认卡三块内容 348px 放不下。
            // 档位选择不在本面板落值：实例行/缺档待办点击 → 关面板跳中栏 tier 合成点
            // （普通 L3 单选点，走既有 select+confirm 通道，零新机制）。
            // 组合校验语义（定稿 §4.2(c)）：红 = 硬违例拦冻结；黄 = 提示义务，不是禁止。
            // -----------------------------------------------------------------
            if root.active-view == "design" && root.system-panel-open: Rectangle {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #54aeff;
                border-width: 2px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Text {
                            text: "系统组合（模块实例 · 重度档位 · 组合校验 · |H| 形态确认）";
                            font-size: 14px;
                            font-weight: 700;
                            color: #1f2328;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Button { text: "刷新"; width: 76px; clicked => { root.system-refresh(); } }
                        Button { text: "关闭"; width: 76px; clicked => { root.system-panel-open = false; } }
                    }
                    Text {
                        text: root.system-summary;
                        height: 40px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 10px;

                        // 左：系统实例清单（点击跳档位点）+ 私有模块只读清单
                        VerticalLayout {
                            width: 46%;
                            spacing: 6px;
                            Text {
                                text: "系统实例（点击行前往该实例的档位合成点）";
                                height: 20px;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1f2328;
                            }
                            ListView {
                                vertical-stretch: 3;
                                for row in root.system-instance-rows: Rectangle {
                                    height: row.kind == "header" ? 28px : 56px;
                                    background: row.kind == "header" ? #f6f8fa : #ffffff;
                                    border-color: #eaeef2;
                                    border-width: row.kind == "header" ? 0px : 1px;
                                    if row.target != "": TouchArea {
                                        clicked => {
                                            root.system-panel-open = false;
                                            root.select-decision(row.target);
                                        }
                                    }
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: #1f2328;
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: row.kind == "bad"
                                                ? #cf222e
                                                : (row.kind == "ok" ? #1a7f37 : #57606a);
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "项目私有模块（只读清单；登记走后端校验通道）";
                                height: 20px;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1f2328;
                            }
                            ListView {
                                vertical-stretch: 2;
                                for row in root.system-module-rows: Rectangle {
                                    height: row.kind == "header" ? 28px : 56px;
                                    background: row.kind == "header" ? #f6f8fa : #ffffff;
                                    border-color: #eaeef2;
                                    border-width: row.kind == "header" ? 0px : 1px;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: #1f2328;
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: #57606a;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // 右：组合校验报告（红拦/黄提示）+ 署名形态确认流
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text {
                                text: "组合校验（红 = 硬违例，冻结门第 2 道拦截；黄 = 提示义务，不拦冻结）";
                                height: 20px;
                                font-size: 12px;
                                font-weight: 700;
                                color: #1f2328;
                                overflow: elide;
                            }
                            ListView {
                                vertical-stretch: 1;
                                for row in root.system-report-rows: Rectangle {
                                    height: row.kind == "header" ? 28px : 60px;
                                    background: row.kind == "header"
                                        ? #f6f8fa
                                        : (row.kind == "bad"
                                            ? #fff5f5
                                            : (row.kind == "warn" ? #fff8c5 : #ffffff));
                                    border-color: #eaeef2;
                                    border-width: row.kind == "header" ? 0px : 1px;
                                    if row.target != "": TouchArea {
                                        clicked => {
                                            root.system-panel-open = false;
                                            root.select-decision(row.target);
                                        }
                                    }
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Text {
                                            text: row.title;
                                            font-size: row.kind == "header" ? 12px : 11px;
                                            font-weight: row.kind == "header" ? 700 : 400;
                                            color: row.kind == "bad"
                                                ? #cf222e
                                                : (row.kind == "warn"
                                                    ? #9a6700
                                                    : (row.kind == "ok" ? #1a7f37 : #1f2328));
                                            overflow: elide;
                                        }
                                        if row.kind != "header": Text {
                                            text: row.text;
                                            font-size: 10px;
                                            color: row.kind == "bad"
                                                ? #cf222e
                                                : (row.kind == "warn" ? #9a6700 : #57606a);
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // |H| 超参考线的一次性署名形态确认卡（仅后端要求时出现；
                            // 确认必须是用户点击，无任何自动署名路径）。
                            if root.system-confirm-required: Rectangle {
                                height: 148px;
                                background: #fff8c5;
                                border-color: #d4a72c;
                                border-width: 1px;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: root.system-confirm-text;
                                        vertical-stretch: 1;
                                        font-size: 11px;
                                        color: #7d4e00;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        height: 28px;
                                        spacing: 6px;
                                        system-signer := LineEdit {
                                            placeholder-text: "署名（必填）";
                                            width: 160px;
                                        }
                                        system-note := LineEdit {
                                            placeholder-text: "确认说明（可选，如对标游戏）";
                                            horizontal-stretch: 1;
                                        }
                                        Button {
                                            text: "署名确认形态";
                                            width: 118px;
                                            primary: true;
                                            clicked => {
                                                root.system-confirm-form(system-signer.text, system-note.text);
                                            }
                                        }
                                    }
                                }
                            }
                            if root.system-confirmed-text != "": Rectangle {
                                height: 56px;
                                background: #eaf5ea;
                                border-color: #1a7f37;
                                border-width: 1px;
                                border-radius: 6px;
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: root.system-confirmed-text;
                                        font-size: 11px;
                                        color: #1a7f37;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 覆盖面板四：风格预览大图（册 08 §2.3「双击图片全屏放大」）
            //
            // 全窗覆盖而不是在 348px 的右栏里放大：风格是靠看图定的，缩略图看不出材质
            // 与可读性。点遮罩或「关闭」退出；提示词原文一并显示（看图时要知道要求的是什么）。
            // -----------------------------------------------------------------
            if root.style-viewer-open: Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #10182099;

                TouchArea {
                    clicked => { root.style-viewer-open = false; }
                }
                Rectangle {
                    x: 40px;
                    y: 28px;
                    width: parent.width - 80px;
                    height: parent.height - 56px;
                    background: #ffffff;
                    border-color: #54aeff;
                    border-width: 2px;
                    border-radius: 8px;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Text {
                                text: root.style-viewer-title;
                                font-size: 15px;
                                font-weight: 700;
                                color: #1f2328;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Button { text: "关闭"; width: 76px; clicked => { root.style-viewer-open = false; } }
                        }
                        if root.style-viewer-has-image: Image {
                            source: root.style-viewer-image;
                            vertical-stretch: 1;
                            image-fit: contain;
                        }
                        if !root.style-viewer-has-image: Text {
                            text: "该方向还没有预览图（尚未生成，或上一轮生成失败——原因见卡片上的红字）。";
                            vertical-stretch: 1;
                            font-size: 12px;
                            color: #cf222e;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.style-viewer-prompt;
                            height: 76px;
                            font-size: 11px;
                            color: #57606a;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // -----------------------------------------------------------------
            // 覆盖面板三：AI Provider 配置与体检（全局，任何视图下可开）
            // -----------------------------------------------------------------
            if root.ai-panel-open: Rectangle {
                x: 16px;
                y: 12px;
                width: parent.width - 32px;
                height: parent.height - 24px;
                background: #ffffff;
                border-color: #54aeff;
                border-width: 2px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Text {
                            text: "AI Provider 配置与体检（写入 config/app.json）";
                            font-size: 14px;
                            font-weight: 700;
                            color: #1f2328;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.ai-status;
                            font-size: 12px;
                            color: root.ai-available ? #1a7f37 : #cf222e;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Button { text: "刷新"; width: 72px; clicked => { root.ai-refresh(); } }
                        Button { text: "关闭"; width: 72px; clicked => { root.ai-panel-open = false; } }
                    }
                    Text {
                        text: "AI 介入点：访谈提案 / 冻结门红队 / 流水线 C1-C5 / 逆向 S2-S3。未配置或密钥解析不了时，这些功能一律显式 blocked（不做模板兜底，R7）。";
                        height: 30px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.ai-config-summary;
                        height: 30px;
                        font-size: 11px;
                        color: #1f2328;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Text { text: "内置 preset"; width: 80px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-preset-box := ComboBox { model: root.ai-presets; width: 200px; }
                        Button {
                            text: "套用 preset 到表单";
                            width: 156px;
                            clicked => { root.ai-apply-preset(ai-preset-box.current-value); }
                        }
                        Text {
                            text: "套用只填表单，点「保存并诊断」才落盘。";
                            font-size: 11px;
                            color: #6e7781;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Text { text: "Provider id"; width: 80px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-id := LineEdit { text <=> root.ai-provider-id; placeholder-text: "例如 openai"; width: 200px; }
                        Text { text: "模型"; width: 40px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-model-edit := LineEdit { text <=> root.ai-model; placeholder-text: "例如 gpt-4o-mini"; horizontal-stretch: 1; }
                        Text { text: "超时(s)"; width: 56px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-timeout-edit := LineEdit { text <=> root.ai-timeout; placeholder-text: "120"; width: 90px; }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Text { text: "Base URL"; width: 80px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-url := LineEdit { text <=> root.ai-base-url; placeholder-text: "例如 https://api.openai.com/v1"; horizontal-stretch: 1; }
                        Text { text: "密钥引用"; width: 60px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-key := LineEdit { text <=> root.ai-key-ref; placeholder-text: "env:OPENAI_API_KEY 或 named:my_key"; width: 280px; }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Button {
                            text: "保存并诊断";
                            width: 120px;
                            primary: true;
                            clicked => { root.ai-save(ai-id.text, ai-url.text, ai-model-edit.text, ai-key.text, ai-timeout-edit.text); }
                        }
                        Button { text: "只诊断（查配置）"; width: 132px; clicked => { root.ai-doctor(); } }
                        Button {
                            text: root.ai-invoke-running ? "实调用中…" : "实调用检查（真打一次）";
                            width: 196px;
                            enabled: !root.ai-invoke-running;
                            clicked => { root.ai-invoke-check(); }
                        }
                        Button { text: "停用 AI（清空配置）"; width: 168px; clicked => { root.ai-disable(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "「只诊断」零网络，只看配置在不在、密钥解析得出来——base_url 写错 / 密钥失效 / 模型名不存在它照旧报可用。「实调用检查」真发一次最小请求（走网络、消耗额度），失败原因原样呈现，不重试不兜底（R7）。";
                        height: 44px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Text { text: "写入密钥"; width: 80px; font-size: 12px; color: #57606a; vertical-alignment: center; }
                        ai-secret-name-edit := LineEdit {
                            text <=> root.ai-secret-name;
                            placeholder-text: "密钥名，例如 my_key";
                            width: 200px;
                        }
                        ai-secret-value-edit := LineEdit {
                            text <=> root.ai-secret-value;
                            input-type: InputType.password;
                            placeholder-text: "真实密钥（只落 config/secrets.json）";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "保存密钥";
                            width: 96px;
                            clicked => { root.ai-save-secret(ai-secret-name-edit.text, ai-secret-value-edit.text); }
                        }
                    }
                    Text {
                        text: "密钥本身不写进 app.json：上面「密钥引用」只填引用。env:NAME 读环境变量；named:NAME 读 config/secrets.json——用这一行直接写入即可，无需手工维护该文件。密钥值不落运行日志、不进存档与导出包、不进任何报告。";
                        height: 44px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.ai-secret-names;
                        height: 20px;
                        font-size: 11px;
                        color: #6e7781;
                        overflow: elide;
                    }

                    // ---- 图像通道（config/app.json 的 image_provider 段）----
                    // 与文本通道分开配：同一厂商的图像与文本是两个 endpoint、两套模型名，
                    // 合成一份配置会让「文本能用」被当成「图像也能用」（R7 误报）。
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        Text { text: "图像通道"; width: 80px; font-size: 12px; font-weight: 700; color: #1f2328; vertical-alignment: center; }
                        image-preset-box := ComboBox { model: root.image-presets; width: 180px; }
                        Button {
                            text: "套用 preset";
                            width: 104px;
                            clicked => { root.image-apply-preset(image-preset-box.current-value); }
                        }
                        Text {
                            text: root.image-status;
                            font-size: 11px;
                            color: root.image-available ? #1a7f37 : #cf222e;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        image-id := LineEdit { text <=> root.image-provider-id; placeholder-text: "provider id，例如 openai_images"; width: 200px; }
                        image-model-edit := LineEdit { text <=> root.image-model; placeholder-text: "模型，例如 gpt-image-1"; horizontal-stretch: 1; }
                        image-size-edit := LineEdit { text <=> root.image-size; placeholder-text: "1024x1024"; width: 110px; }
                        image-timeout-edit := LineEdit { text <=> root.image-timeout; placeholder-text: "300"; width: 80px; }
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        image-url := LineEdit { text <=> root.image-base-url; placeholder-text: "图像 base_url，例如 https://api.openai.com/v1"; horizontal-stretch: 1; }
                        image-key := LineEdit { text <=> root.image-key-ref; placeholder-text: "env:OPENAI_API_KEY 或 named:my_key"; width: 260px; }
                        Button {
                            text: "保存图像通道";
                            width: 124px;
                            clicked => {
                                root.image-save(
                                    image-id.text,
                                    image-url.text,
                                    image-model-edit.text,
                                    image-key.text,
                                    image-size-edit.text,
                                    image-timeout-edit.text
                                );
                            }
                        }
                        Button { text: "停用图像通道"; width: 116px; clicked => { root.image-disable(); } }
                    }
                    Text {
                        text: "图像通道只被设计工作台的「风格」页签使用（看真图定风格锚点）。未配置时风格生成入口显式 blocked——不产占位图冒充真图（R7）。尺寸写错在保存时就会被拒，不会静默回落到默认值。";
                        height: 44px;
                        font-size: 11px;
                        color: #57606a;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.ai-invoke-rows: Rectangle {
                            height: row.kind == "header" ? 26px : 38px;
                            background: #ffffff;
                            border-color: #eaeef2;
                            border-width: 1px;
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 2px;
                                Text {
                                    text: row.title;
                                    font-size: 12px;
                                    font-weight: row.kind == "header" ? 700 : 400;
                                    color: row.kind == "bad" ? #cf222e : (row.kind == "ok" ? #1a7f37 : #1f2328);
                                    overflow: elide;
                                }
                                if row.kind != "header": Text {
                                    text: row.text;
                                    font-size: 11px;
                                    color: #57606a;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.ai-doctor-rows: Rectangle {
                            height: row.kind == "header" ? 26px : 38px;
                            background: #ffffff;
                            border-color: #eaeef2;
                            border-width: 1px;
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 2px;
                                Text {
                                    text: row.title;
                                    font-size: row.kind == "header" ? 12px : 12px;
                                    font-weight: row.kind == "header" ? 700 : 400;
                                    color: row.kind == "bad" ? #cf222e : (row.kind == "ok" ? #1a7f37 : #1f2328);
                                    overflow: elide;
                                }
                                if row.kind != "header": Text {
                                    text: row.text;
                                    font-size: 11px;
                                    color: #57606a;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    Text {
                        text: "改动即时生效：保存/刷新会同时更新落盘配置与运行期生效配置（AppServices::set_ai_provider / reload_config），无需重启。";
                        height: 20px;
                        font-size: 11px;
                        color: #6e7781;
                        overflow: elide;
                    }
                }
            }
        }

        // =====================================================================
        // 底部状态栏：左=当前项目/包，中=完成度，右=最近操作结果
        // =====================================================================
        Rectangle {
            height: 30px;
            background: #ffffff;
            border-color: #d0d7de;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Text {
                    text: root.project-title + (root.project-pack == "" ? "" : "  ·  " + root.project-pack);
                    width: 26%;
                    font-size: 11px;
                    color: #57606a;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // 底栏 AI Provider 状态（docs/design/06 §4）：不可用时红字照实显示。
                Text {
                    text: root.ai-status;
                    width: 20%;
                    font-size: 11px;
                    color: root.ai-available ? #1a7f37 : #cf222e;
                    vertical-alignment: center;
                    overflow: elide;
                }
                HorizontalLayout {
                    width: 30%;
                    spacing: 8px;
                    Text {
                        text: root.completeness-text == "" ? "完成度：尚未打开项目" : root.completeness-text;
                        font-size: 11px;
                        color: #57606a;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    ProgressIndicator {
                        progress: root.completeness-ratio;
                        width: 80px;
                        height: 8px;
                    }
                }
                Text {
                    text: root.status-message;
                    horizontal-stretch: 1;
                    font-size: 11px;
                    color: #24292f;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
